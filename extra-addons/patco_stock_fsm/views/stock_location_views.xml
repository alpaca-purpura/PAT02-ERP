<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de formulario para ubicaciones de vehículos -->
    <record id="view_stock_location_vehicle_form" model="ir.ui.view">
        <field name="name">stock.location.vehicle.form</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <field name="usage" position="after">
                <field name="is_vehicle_location"/>
                <field name="technician_id" invisible="not is_vehicle_location" required="is_vehicle_location"/>
                <field name="vehicle_code" invisible="not is_vehicle_location" required="is_vehicle_location"/>
                <field name="max_capacity" invisible="not is_vehicle_location"/>
            </field>
            <field name="usage" position="before">
                <field name="current_weight" invisible="not is_vehicle_location" readonly="1"/>
                <field name="capacity_percentage" invisible="not is_vehicle_location" readonly="1" widget="percentage"/>
            </field>
        </field>
    </record>

    <!-- Vista de lista para ubicaciones de vehículos -->
    <record id="view_stock_location_vehicle_list" model="ir.ui.view">
        <field name="name">stock.location.vehicle.list</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_tree2"/>
        <field name="arch" type="xml">
            <field name="usage" position="after">
                <field name="is_vehicle_location" optional="show"/>
                <field name="technician_id" optional="show"/>
                <field name="vehicle_code" optional="show"/>
                <field name="current_weight" optional="hide"/>
                <field name="capacity_percentage" optional="hide" widget="percentage"/>
            </field>
        </field>
    </record>

    <!-- Filtro para ubicaciones de vehículos -->
    <record id="view_stock_location_vehicle_search" model="ir.ui.view">
        <field name="name">stock.location.vehicle.search</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_search"/>
        <field name="arch" type="xml">
            <search position="inside">
                <filter name="vehicle_locations" string="Ubicaciones de Vehículos" 
                        domain="[('is_vehicle_location', '=', True)]"/>
                <separator/>
                <!-- Filtros de capacidad removidos temporalmente - capacity_percentage es un campo computado no almacenado -->
                <group expand="0" string="Agrupar por">
                    <filter name="group_by_technician" string="Técnico" 
                            context="{'group_by': 'technician_id'}"/>
                    <filter name="group_by_vehicle_location" string="Tipo de Ubicación" 
                            context="{'group_by': 'is_vehicle_location'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción para ubicaciones de vehículos -->
    <record id="action_stock_location_vehicle" model="ir.actions.act_window">
        <field name="name">Ubicaciones de Vehículos</field>
        <field name="res_model">stock.location</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_vehicle_location', '=', True)]</field>
        <field name="context">{'default_is_vehicle_location': True, 'default_usage': 'internal'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Crea tu primera ubicación de vehículo!
            </p>
            <p>
                Las ubicaciones de vehículos permiten gestionar el stock móvil
                que llevan los técnicos en sus vehículos de servicio.
            </p>
        </field>
    </record>

    <!-- Vista kanban para ubicaciones de vehículos -->
    <record id="view_stock_location_vehicle_kanban" model="ir.ui.view">
        <field name="name">stock.location.vehicle.kanban</field>
        <field name="model">stock.location</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="vehicle_code"/>
                <field name="technician_id"/>
                <field name="current_weight"/>
                <field name="max_capacity"/>
                <field name="capacity_percentage"/>
                <field name="is_vehicle_location"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top mb16">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle text-muted">
                                        <t t-if="record.vehicle_code.value">
                                            Código: <field name="vehicle_code"/>
                                        </t>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <t t-if="record.technician_id.value">
                                    <div><i class="fa fa-user"/> <field name="technician_id"/></div>
                                </t>
                                <t t-if="record.is_vehicle_location.value">
                                    <div class="mt8">
                                        <div class="progress" style="height: 20px;">
                                            <div class="progress-bar" 
                                                 t-attf-style="width: #{record.capacity_percentage.value}%;"
                                                 t-attf-class="progress-bar #{record.capacity_percentage.value > 80 and 'bg-danger' or record.capacity_percentage.value > 60 and 'bg-warning' or 'bg-success'}">
                                                <t t-esc="Math.round(record.capacity_percentage.value)"/>%
                                            </div>
                                        </div>
                                        <small class="text-muted">
                                            <t t-esc="record.current_weight.value"/> / <t t-esc="record.max_capacity.value"/> kg
                                        </small>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Acción para vista kanban de vehículos -->
    <record id="action_stock_location_vehicle_kanban" model="ir.actions.act_window">
        <field name="name">Vehículos - Vista Kanban</field>
        <field name="res_model">stock.location</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_vehicle_location', '=', True)]</field>
        <field name="context">{'default_is_vehicle_location': True, 'default_usage': 'internal'}</field>
        <field name="view_id" ref="view_stock_location_vehicle_kanban"/>
    </record>

</odoo>