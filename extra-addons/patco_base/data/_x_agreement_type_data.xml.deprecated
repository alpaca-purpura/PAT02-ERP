<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Tipos de Acuerdo para PATCO -->
        <record id="agreement_type_maintenance_contract" model="agreement.type">
            <field name="name">Contrato de Mantenimiento</field>
            <field name="active">True</field>
        </record>
        
        <record id="agreement_type_maintenance_policy" model="agreement.type">
            <field name="name">Póliza de Mantenimiento</field>
            <field name="active">True</field>
        </record>
        
        <record id="agreement_type_service_level" model="agreement.type">
            <field name="name">Acuerdo de Nivel de Servicio (SLA)</field>
            <field name="active">True</field>
        </record>
        
        <record id="agreement_type_installation" model="agreement.type">
            <field name="name">Contrato de Instalación</field>
            <field name="active">True</field>
        </record>
        
    </data>