<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Service Nature Types -->
        <record id="service_nature_mantenimiento" model="patco.service.nature">
            <field name="name">Mantenimiento</field>
            <field name="code">M1</field>
            <field name="sequence">10</field>
            <field name="description">Servicios de mantenimiento preventivo y correctivo</field>
            <field name="active">True</field>
        </record>
        
        <record id="service_nature_instalacion" model="patco.service.nature">
            <field name="name">Instalación</field>
            <field name="code">I1</field>
            <field name="sequence">20</field>
            <field name="description">Servicios de instalación de equipos nuevos</field>
            <field name="active">True</field>
        </record>
        
        <record id="service_nature_reparacion" model="patco.service.nature">
            <field name="name">Reparación</field>
            <field name="code">R1</field>
            <field name="sequence">30</field>
            <field name="description">Servicios de reparación de equipos averiados</field>
            <field name="active">True</field>
        </record>
        
        <record id="service_nature_diagnostico" model="patco.service.nature">
            <field name="name">Diagnóstico</field>
            <field name="code">D1</field>
            <field name="sequence">40</field>
            <field name="description">Servicios de diagnóstico y evaluación técnica</field>
            <field name="active">True</field>
        </record>
        
        <record id="service_nature_consultoria" model="patco.service.nature">
            <field name="name">Consultoría</field>
            <field name="code">C1</field>
            <field name="sequence">50</field>
            <field name="description">Servicios de consultoría técnica especializada</field>
            <field name="active">True</field>
        </record>
        
        <record id="service_nature_emergencia" model="patco.service.nature">
            <field name="name">Emergencia</field>
            <field name="code">E1</field>
            <field name="sequence">60</field>
            <field name="description">Servicios de emergencia y atención urgente</field>
            <field name="active">True</field>
        </record>
        
    </data>
</odoo>