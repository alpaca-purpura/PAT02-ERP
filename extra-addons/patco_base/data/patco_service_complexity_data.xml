<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Service Complexity Levels -->
        <record id="service_complexity_basico" model="patco.service.complexity">
            <field name="name">Básico</field>
            <field name="code">N1</field>
            <field name="sequence">10</field>
            <field name="description">Servicios de complejidad básica, rutinarios</field>
            <field name="active">True</field>
        </record>
        
        <record id="service_complexity_intermedio" model="patco.service.complexity">
            <field name="name">Intermedio</field>
            <field name="code">N2</field>
            <field name="sequence">20</field>
            <field name="description">Servicios de complejidad intermedia, requieren experiencia</field>
            <field name="active">True</field>
        </record>
        
        <record id="service_complexity_avanzado" model="patco.service.complexity">
            <field name="name">Avanzado</field>
            <field name="code">N3</field>
            <field name="sequence">30</field>
            <field name="description">Servicios de alta complejidad, requieren especialización</field>
            <field name="active">True</field>
        </record>
        
        <record id="service_complexity_critico" model="patco.service.complexity">
            <field name="name">Crítico</field>
            <field name="code">N4</field>
            <field name="sequence">40</field>
            <field name="description">Servicios críticos, requieren máxima especialización</field>
            <field name="active">True</field>
        </record>
        
    </data>
</odoo>