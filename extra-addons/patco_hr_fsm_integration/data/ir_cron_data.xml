<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Cron Job para sincronización de técnicos de campo con FSM -->
        <record id="cron_sync_hr_fsm_integration" model="ir.cron">
            <field name="name">Sincronización HR-FSM: Técnicos de Campo</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="state">code</field>
            <field name="code">model.sync_all_field_technicians()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>

            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>
        
        <!-- Cron Job para sincronización de personas FSM con empleados -->
        <record id="cron_sync_fsm_hr_integration" model="ir.cron">
            <field name="name">Sincronización FSM-HR: Personas de Campo</field>
            <field name="model_id" ref="fieldservice.model_fsm_person"/>
            <field name="state">code</field>
            <field name="code">model.sync_all_with_employees()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>

            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>
        
    </data>
</odoo>