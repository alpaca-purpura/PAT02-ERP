<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Vista de formulario extendida para órdenes de servicio -->
        <record id="view_fsm_order_form_patco" model="ir.ui.view">
            <field name="name">fsm.order.form.patco</field>
            <field name="model">fsm.order</field>
            <field name="inherit_id" ref="fieldservice.fsm_order_form"/>
            <field name="arch" type="xml">
                
                <!-- Agregar sección de múltiples equipos después del técnico -->
                <xpath expr="//field[@name='person_id']" position="after">
                    <group string="🔧 Gestión de Equipos" name="equipment_management_group">
                        <field name="x_equipment_id" string="Equipo Principal" options="{'no_create': True}" 
                               help="Equipo principal para esta orden de servicio"/>
                        <field name="x_equipment_code" readonly="1" invisible="not x_equipment_id"/>
                        <field name="x_customer_equipment" readonly="1" invisible="not x_equipment_id"/>
                        <field name="x_equipment_count" readonly="1" string="Total Equipos"/>
                        <field name="x_equipment_categories" readonly="1" string="Categorías" widget="many2many_tags"/>
                        <field name="x_all_equipment_codes" readonly="1" string="Códigos de Equipos"/>
                    </group>
                    <group string="📋 Múltiples Equipos" name="multiple_equipment_group">
                        <field name="x_equipment_ids" nolabel="1" widget="many2many_tags" 
                               options="{'no_create': True, 'color_field': 'category_id'}" 
                               help="Seleccione todos los equipos involucrados en esta orden">
                            <list>
                                <field name="name"/>
                            </list>
                        </field>
                        <div class="oe_button_box" name="equipment_button_box">
                            <button name="action_view_all_equipment" type="object" class="oe_stat_button" icon="fa-cogs">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value"><field name="x_equipment_count"/></span>
                                    <span class="o_stat_text">Equipos</span>
                                </div>
                            </button>
                            <button name="action_sync_equipment_fields" type="object" class="oe_stat_button" icon="fa-refresh">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">Sincronizar</span>
                                    <span class="o_stat_text">Equipos</span>
                                </div>
                            </button>
                        </div>
                    </group>
                </xpath>
                
            </field>
        </record>
        
        <!-- Vista de lista extendida para órdenes de servicio -->
        <record id="view_fsm_order_list_patco" model="ir.ui.view">
        <field name="name">fsm.order.list.patco</field>
            <field name="model">fsm.order</field>
            <field name="inherit_id" ref="fieldservice.fsm_order_list_view"/>
            <field name="arch" type="xml">
                
                <!-- Agregar columnas de múltiples equipos -->
                <xpath expr="//field[@name='person_id']" position="after">
                    <field name="x_equipment_code" optional="show" string="Equipo Principal"/>
                    <field name="x_equipment_count" optional="show" string="Total Equipos"/>
                    <field name="x_equipment_categories" optional="hide" widget="many2many_tags"/>
                    <field name="x_customer_equipment" optional="hide"/>
                </xpath>
                
            </field>
        </record>
        
        <!-- Vista de búsqueda extendida -->
        <record id="view_fsm_order_search_patco" model="ir.ui.view">
            <field name="name">fsm.order.search.patco</field>
            <field name="model">fsm.order</field>
            <field name="inherit_id" ref="fieldservice.fsm_order_search_view"/>
            <field name="arch" type="xml">
                
                <!-- Agregar filtros de múltiples equipos -->
                <xpath expr="//field[@name='person_id']" position="after">
                    <field name="x_equipment_id" string="Equipo Principal"/>
                    <field name="x_equipment_code"/>
                    <field name="x_equipment_ids" string="Equipos Involucrados"/>
                </xpath>
                
                <xpath expr="//group" position="inside">
                    <filter name="group_equipment" string="Equipo Principal" context="{'group_by': 'x_equipment_id'}"/>
                    <filter name="group_equipment_category" string="Categoría de Equipo" context="{'group_by': 'x_equipment_categories'}"/>
                </xpath>
                
            </field>
        </record>
        
    </data>
</odoo>