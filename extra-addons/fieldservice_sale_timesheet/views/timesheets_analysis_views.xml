<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FSM Order field extension for timesheets analysis -->
    <record id="hr_timesheet_report_search_fsm" model="ir.ui.view">
        <field name="name">timesheets.analysis.report.search.fsm</field>
        <field name="model">timesheets.analysis.report</field>
        <field name="inherit_id" ref="hr_timesheet.hr_timesheet_report_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="fsm_order_id"/>
            </xpath>
        </field>
    </record>
</odoo>