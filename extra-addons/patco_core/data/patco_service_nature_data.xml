<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Service Nature Initial Data -->
        <record id="service_nature_maintenance" model="patco.service.nature">
            <field name="name">Mantenimiento</field>
            <field name="code">MANT</field>
            <field name="sequence">10</field>
            <field name="description">Servicios de mantenimiento preventivo y correctivo de equipos</field>
            <field name="active">True</field>
        </record>

        <record id="service_nature_installation" model="patco.service.nature">
            <field name="name">Instalación</field>
            <field name="code">INST</field>
            <field name="sequence">20</field>
            <field name="description">Servicios de instalación de nuevos equipos y sistemas</field>
            <field name="active">True</field>
        </record>

        <record id="service_nature_repair" model="patco.service.nature">
            <field name="name">Reparación</field>
            <field name="code">REP</field>
            <field name="sequence">30</field>
            <field name="description">Servicios de reparación de equipos averiados</field>
            <field name="active">True</field>
        </record>

        <record id="service_nature_inspection" model="patco.service.nature">
            <field name="name">Inspección</field>
            <field name="code">INSP</field>
            <field name="sequence">40</field>
            <field name="description">Servicios de inspección técnica y diagnóstico</field>
            <field name="active">True</field>
        </record>

        <record id="service_nature_upgrade" model="patco.service.nature">
            <field name="name">Actualización</field>
            <field name="code">ACT</field>
            <field name="sequence">50</field>
            <field name="description">Servicios de actualización y mejora de equipos existentes</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>