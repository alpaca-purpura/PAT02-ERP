<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Service Complexity Initial Data -->
        <record id="service_complexity_basico" model="patco.service.complexity">
            <field name="name">Básico</field>
            <field name="code">N1</field>
            <field name="sequence">10</field>
            <field name="description">Nivel básico - Tareas rutinarias y mantenimiento simple</field>
            <field name="active">True</field>
        </record>

        <record id="service_complexity_intermedio" model="patco.service.complexity">
            <field name="name">Intermedio</field>
            <field name="code">N2</field>
            <field name="sequence">20</field>
            <field name="description">Nivel intermedio - Requiere conocimiento técnico especializado</field>
            <field name="active">True</field>
        </record>

        <record id="service_complexity_avanzado" model="patco.service.complexity">
            <field name="name">Avanzado</field>
            <field name="code">N3</field>
            <field name="sequence">30</field>
            <field name="description">Nivel avanzado - Requiere alta especialización técnica</field>
            <field name="active">True</field>
        </record>

        <record id="service_complexity_critico" model="patco.service.complexity">
            <field name="name">Crítico</field>
            <field name="code">N4</field>
            <field name="sequence">40</field>
            <field name="description">Nivel crítico - Requiere experto certificado y experiencia avanzada</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>