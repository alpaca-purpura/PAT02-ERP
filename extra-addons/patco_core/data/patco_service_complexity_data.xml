<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Service Complexity Initial Data -->
        <record id="service_complexity_low" model="patco.service.complexity">
            <field name="name">Baja</field>
            <field name="code">BAJA</field>
            <field name="sequence">10</field>
            <field name="description">Servicios de baja complejidad técnica, rutinarios y estándar</field>
            <field name="active">True</field>
        </record>

        <record id="service_complexity_medium" model="patco.service.complexity">
            <field name="name">Media</field>
            <field name="code">MEDIA</field>
            <field name="sequence">20</field>
            <field name="description">Servicios de complejidad media que requieren conocimientos especializados</field>
            <field name="active">True</field>
        </record>

        <record id="service_complexity_high" model="patco.service.complexity">
            <field name="name">Alta</field>
            <field name="code">ALTA</field>
            <field name="sequence">30</field>
            <field name="description">Servicios de alta complejidad técnica que requieren experiencia avanzada</field>
            <field name="active">True</field>
        </record>

        <record id="service_complexity_critical" model="patco.service.complexity">
            <field name="name">Crítica</field>
            <field name="code">CRIT</field>
            <field name="sequence">40</field>
            <field name="description">Servicios críticos de máxima complejidad que requieren especialistas expertos</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>