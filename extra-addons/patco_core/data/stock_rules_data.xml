<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Rutas de stock para vehículos -->
        <record id="stock_route_vehicles" model="stock.route">
            <field name="name">Abastecimiento de Vehículos</field>
            <field name="active">True</field>
            <field name="sequence">10</field>
            <field name="company_id" ref="base.main_company"/>
        </record>
        
        <!-- Reglas de stock para transferencias automáticas -->
        <record id="stock_rule_vehicle_001" model="stock.rule">
            <field name="name">Abastecer Vehículo 001</field>
            <field name="route_id" ref="stock_route_vehicles"/>
            <field name="location_src_id" ref="stock.stock_location_stock"/>
            <field name="location_dest_id" ref="stock_location_vehicle_001"/>
            <field name="action">pull</field>
            <field name="picking_type_id" ref="stock.picking_type_internal"/>
            <field name="procure_method">make_to_stock</field>
            <field name="sequence">10</field>
            <field name="active">True</field>
            <field name="auto">manual</field>
            <field name="company_id" ref="base.main_company"/>
        </record>
        
        <record id="stock_rule_vehicle_002" model="stock.rule">
            <field name="name">Abastecer Vehículo 002</field>
            <field name="route_id" ref="stock_route_vehicles"/>
            <field name="location_src_id" ref="stock.stock_location_stock"/>
            <field name="location_dest_id" ref="stock_location_vehicle_002"/>
            <field name="action">pull</field>
            <field name="picking_type_id" ref="stock.picking_type_internal"/>
            <field name="procure_method">make_to_stock</field>
            <field name="sequence">20</field>
            <field name="active">True</field>
            <field name="auto">manual</field>
            <field name="company_id" ref="base.main_company"/>
        </record>
        
        <record id="stock_rule_vehicle_003" model="stock.rule">
            <field name="name">Abastecer Vehículo 003</field>
            <field name="route_id" ref="stock_route_vehicles"/>
            <field name="location_src_id" ref="stock.stock_location_stock"/>
            <field name="location_dest_id" ref="stock_location_vehicle_003"/>
            <field name="action">pull</field>
            <field name="picking_type_id" ref="stock.picking_type_internal"/>
            <field name="procure_method">make_to_stock</field>
            <field name="sequence">30</field>
            <field name="active">True</field>
            <field name="auto">manual</field>
            <field name="company_id" ref="base.main_company"/>
        </record>
        
        <!-- Reglas de reabastecimiento automático -->
        <record id="orderpoint_vehicle_001_air_filter" model="stock.warehouse.orderpoint">
            <field name="product_id" ref="product_air_filter"/>
            <field name="location_id" ref="stock_location_vehicle_001"/>
            <field name="product_min_qty">2</field>
            <field name="product_max_qty">5</field>
            <field name="qty_multiple">1</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="active">True</field>
        </record>
        
        <record id="orderpoint_vehicle_001_oil_filter" model="stock.warehouse.orderpoint">
            <field name="product_id" ref="product_oil_filter"/>
            <field name="location_id" ref="stock_location_vehicle_001"/>
            <field name="product_min_qty">3</field>
            <field name="product_max_qty">6</field>
            <field name="qty_multiple">1</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="active">True</field>
        </record>
        
        <record id="orderpoint_vehicle_001_engine_oil" model="stock.warehouse.orderpoint">
            <field name="product_id" ref="product_engine_oil"/>
            <field name="location_id" ref="stock_location_vehicle_001"/>
            <field name="product_min_qty">10</field>
            <field name="product_max_qty">20</field>
            <field name="qty_multiple">5</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="active">True</field>
        </record>
        
        <!-- Tipos de operación específicos para vehículos -->
        <record id="picking_type_vehicle_loading" model="stock.picking.type">
            <field name="name">Carga de Vehículos</field>
            <field name="code">internal</field>
            <field name="warehouse_id" ref="stock.warehouse0"/>
            <field name="sequence_id" ref="stock.seq_picking_type_internal"/>
            <field name="default_location_src_id" ref="stock.stock_location_stock"/>
            <field name="default_location_dest_id" ref="stock_location_vehicles"/>
            <field name="active">True</field>
            <field name="company_id" ref="base.main_company"/>
        </record>
        
        <record id="picking_type_field_consumption" model="stock.picking.type">
            <field name="name">Consumo en Campo</field>
            <field name="code">outgoing</field>
            <field name="warehouse_id" ref="stock.warehouse0"/>
            <field name="sequence_id" ref="stock.seq_picking_type_out"/>
            <field name="default_location_src_id" ref="stock_location_vehicles"/>
            <field name="default_location_dest_id" ref="stock_location_field_consumption"/>
            <field name="active">True</field>
            <field name="company_id" ref="base.main_company"/>
        </record>
        
    </data>
</odoo>