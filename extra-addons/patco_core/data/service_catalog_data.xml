<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Categorías de Productos de Servicio -->
        <record id="product_category_maintenance_services" model="product.category">
            <field name="name">Servicios de Mantenimiento</field>
            <field name="parent_id" ref="product.product_category_all"/>
        </record>
        
        <record id="product_category_spare_parts" model="product.category">
            <field name="name">Repuestos y Componentes</field>
            <field name="parent_id" ref="product.product_category_all"/>
        </record>
        
        <!-- Productos de Servicio -->
        <record id="service_corrective_hourly" model="product.product">
            <field name="name">Servicio Correctivo H/H</field>
            <field name="default_code">SRV-CORR-HH</field>
            <field name="type">service</field>
            <field name="categ_id" ref="product_category_maintenance_services"/>
            <field name="list_price">150.00</field>
            <field name="standard_price">100.00</field>
            <field name="uom_id" ref="uom.product_uom_hour"/>
            <field name="uom_po_id" ref="uom.product_uom_hour"/>
            <field name="invoice_policy">delivery</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
        </record>
        
        <record id="service_preventive_plan" model="product.product">
            <field name="name">Plan de Mantenimiento Preventivo</field>
            <field name="default_code">SRV-PREV-PLAN</field>
            <field name="type">service</field>
            <field name="categ_id" ref="product_category_maintenance_services"/>
            <field name="list_price">2400.00</field>
            <field name="standard_price">1800.00</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="uom_po_id" ref="uom.product_uom_unit"/>
            <field name="invoice_policy">order</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
        </record>
        
        <record id="service_equipment_installation" model="product.product">
            <field name="name">Instalación de Equipo Nuevo</field>
            <field name="default_code">SRV-INST-NEW</field>
            <field name="type">service</field>
            <field name="categ_id" ref="product_category_maintenance_services"/>
            <field name="list_price">500.00</field>
            <field name="standard_price">350.00</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="uom_po_id" ref="uom.product_uom_unit"/>
            <field name="invoice_policy">delivery</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
        </record>
        
        <record id="service_emergency_call" model="product.product">
            <field name="name">Llamada de Emergencia</field>
            <field name="default_code">SRV-EMERG</field>
            <field name="type">service</field>
            <field name="categ_id" ref="product_category_maintenance_services"/>
            <field name="list_price">300.00</field>
            <field name="standard_price">200.00</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="uom_po_id" ref="uom.product_uom_unit"/>
            <field name="invoice_policy">delivery</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
        </record>
        
        <!-- Productos Almacenables - Repuestos Comunes -->
        <record id="spare_part_filter_generic" model="product.product">
            <field name="name">Filtro Genérico</field>
            <field name="default_code">SP-FILTER-GEN</field>
            <field name="type">consu</field>
            <field name="categ_id" ref="product_category_spare_parts"/>
            <field name="list_price">25.00</field>
            <field name="standard_price">15.00</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="uom_po_id" ref="uom.product_uom_unit"/>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">True</field>
        </record>
        
        <record id="spare_part_gasket_door" model="product.product">
            <field name="name">Empaque de Puerta</field>
            <field name="default_code">SP-GASKET-DOOR</field>
            <field name="type">consu</field>
            <field name="categ_id" ref="product_category_spare_parts"/>
            <field name="list_price">45.00</field>
            <field name="standard_price">30.00</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="uom_po_id" ref="uom.product_uom_unit"/>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">True</field>
        </record>
        
        <record id="spare_part_thermostat" model="product.product">
            <field name="name">Termostato Digital</field>
            <field name="default_code">SP-THERMO-DIG</field>
            <field name="type">consu</field>
            <field name="categ_id" ref="product_category_spare_parts"/>
            <field name="list_price">120.00</field>
            <field name="standard_price">80.00</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="uom_po_id" ref="uom.product_uom_unit"/>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">True</field>
        </record>
        
    </data>
</odoo>