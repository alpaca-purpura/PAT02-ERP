<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Acción: Mis Órdenes de Servicio -->
        <record id="action_fsm_order_my_orders" model="ir.actions.act_window">
            <field name="name">Mis Órdenes de Servicio</field>
            <field name="res_model">fsm.order</field>
            <field name="view_mode">kanban,tree,form,calendar</field>
            <field name="domain">[('person_ids', 'in', [uid])]</field>
            <field name="context">{
                'default_person_ids': [(4, uid)],
                'search_default_my_orders': 1,
                'search_default_open': 1
            }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    ¡No tienes órdenes de servicio asignadas!
                </p>
                <p>
                    Las órdenes de servicio asignadas a ti aparecerán aquí.
                </p>
            </field>
        </record>
        
        <!-- Acción: Hojas de Trabajo -->
        <record id="action_fsm_worksheet" model="ir.actions.act_window">
            <field name="name">Hojas de Trabajo</field>
            <field name="res_model">fsm.worksheet</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    ¡No hay hojas de trabajo!
                </p>
                <p>
                    Las hojas de trabajo se crean automáticamente cuando se inicia una orden de servicio.
                </p>
            </field>
        </record>
        
        <!-- Acción: Consumo de Repuestos -->
        <record id="action_fsm_order_consumed_part" model="ir.actions.act_window">
            <field name="name">Consumo de Repuestos</field>
            <field name="res_model">fsm.order.consumed.part</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    ¡No hay consumo de repuestos registrado!
                </p>
                <p>
                    El consumo de repuestos se registra desde las órdenes de servicio.
                </p>
            </field>
        </record>
        
        <!-- Acción: Registro de Tiempo FSM -->
        <record id="action_fsm_timesheet" model="ir.actions.act_window">
            <field name="name">Registro de Tiempo - Field Service</field>
            <field name="res_model">account.analytic.line</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('fsm_order_id', '!=', False)]</field>
            <field name="context">{
                'search_default_user_id': [uid],
                'search_default_week': 1,
                'default_user_id': uid
            }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    ¡No hay registros de tiempo!
                </p>
                <p>
                    Los registros de tiempo se crean automáticamente desde las órdenes de servicio.
                </p>
            </field>
        </record>
        
        <!-- Vista de búsqueda personalizada para Mis Órdenes -->
        <record id="view_fsm_order_search_my_orders" model="ir.ui.view">
            <field name="name">fsm.order.search.my.orders</field>
            <field name="model">fsm.order</field>
            <field name="inherit_id" ref="fieldservice.fsm_order_search_view"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <filter name="my_orders" string="Mis Órdenes" 
                            domain="[('person_ids', 'in', [uid])]"/>
                    <filter name="open" string="Abiertas" 
                            domain="[('stage_id.is_closed', '=', False)]"/>
                    <filter name="closed" string="Cerradas" 
                            domain="[('stage_id.is_closed', '=', True)]"/>
                    <separator/>
                    <filter name="today" string="Hoy" 
                            domain="[('scheduled_date_start', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))), ('scheduled_date_start', '&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]"/>
                    <filter name="this_week" string="Esta Semana" 
                            domain="[('scheduled_date_start', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d')), ('scheduled_date_start', '&lt;=', (context_today() + datetime.timedelta(days=6-context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                </xpath>
            </field>
        </record>
        
    </data>
</odoo>