<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="base.main_company" model="res.company">
            <field name="logo" type="base64" file="patco_core/static/src/img/PATCO-Logo.png"/>
        </record>
        <!-- Las categorías de productos ahora están en product_categories_consolidated.xml -->
        
        <record id="product_preventive_maintenance" model="product.product">
            <field name="name">Servicio de Mantenimiento Preventivo</field>
            <field name="type">service</field>
            <field name="categ_id" ref="product_category_preventive_maintenance"/>
            <field name="list_price">500.00</field>
            <field name="standard_price">300.00</field>
            <field name="uom_id" ref="uom.product_uom_hour"/>
            <field name="uom_po_id" ref="uom.product_uom_hour"/>
            <field name="invoice_policy">delivery</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="description_sale">Servicio de mantenimiento preventivo para equipos industriales</field>
        </record>
        
        <record id="product_corrective_maintenance" model="product.product">
            <field name="name">Servicio de Mantenimiento Correctivo</field>
            <field name="type">service</field>
            <field name="categ_id" ref="product_category_corrective_maintenance"/>
            <field name="list_price">800.00</field>
            <field name="standard_price">500.00</field>
            <field name="uom_id" ref="uom.product_uom_hour"/>
            <field name="uom_po_id" ref="uom.product_uom_hour"/>
            <field name="invoice_policy">delivery</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="description_sale">Servicio de mantenimiento correctivo para equipos industriales</field>
        </record>
        
        <record id="partner_hotel_example" model="res.partner">
            <field name="name">Hotel Plaza Lima</field>
            <field name="is_company">True</field>
            <field name="customer_rank">1</field>
            <field name="street">Jr. de la Unión 1234</field>
            <field name="city">Lima</field>
            <field name="zip">15001</field>
            <field name="country_id" ref="base.pe"/>
            <field name="phone">+51 1 987-6543</field>
            <field name="email">contacto@hotelplaza.com.pe</field>
            </record>
        
        <record id="partner_restaurant_example" model="res.partner">
            <field name="name">Restaurante El Dorado</field>
            <field name="is_company">True</field>
            <field name="customer_rank">1</field>
            <field name="street">Av. Larco 567</field>
            <field name="city">Miraflores</field>
            <field name="zip">15074</field>
            <field name="country_id" ref="base.pe"/>
            <field name="phone">+51 1 456-7890</field>
            <field name="email">gerencia@eldorado.com.pe</field>
            </record>
    </data>
</odoo>