<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Las categorías de productos ahora están en product_categories_consolidated.xml -->
        
        <!-- Productos de repuestos básicos -->
        
        <!-- Filtros -->
        <record id="product_air_filter" model="product.template">
            <field name="name">Filtro de Aire</field>
            <field name="type">consu</field>
            <field name="is_storable">True</field>
            <field name="categ_id" ref="product_category_filters"/>
            <field name="list_price">25.00</field>
            <field name="standard_price">15.00</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="uom_po_id" ref="uom.product_uom_unit"/>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">True</field>
        </record>
        
        <record id="product_oil_filter" model="product.template">
            <field name="name">Filtro de Aceite</field>
            <field name="type">consu</field>
            <field name="is_storable">True</field>
            <field name="categ_id" ref="product_category_filters"/>
            <field name="list_price">18.00</field>
            <field name="standard_price">12.00</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="uom_po_id" ref="uom.product_uom_unit"/>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">True</field>
            <field name="tracking">lot</field>
        </record>
        
        <record id="product_fuel_filter" model="product.template">
            <field name="name">Filtro de Combustible</field>
            <field name="type">consu</field>
            <field name="is_storable">True</field>
            <field name="categ_id" ref="product_category_filters"/>
            <field name="list_price">22.00</field>
            <field name="standard_price">14.00</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="uom_po_id" ref="uom.product_uom_unit"/>
            <field name="tracking">lot</field>
        </record>
        
        <!-- Aceites y Lubricantes -->
        <record id="product_engine_oil" model="product.template">
            <field name="name">Aceite de Motor 15W-40</field>
            <field name="type">consu</field>
            <field name="is_storable">True</field>
            <field name="categ_id" ref="product_category_oils"/>
            <field name="list_price">45.00</field>
            <field name="standard_price">30.00</field>
            <field name="uom_id" ref="uom.product_uom_litre"/>
            <field name="uom_po_id" ref="uom.product_uom_litre"/>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">True</field>
            <field name="tracking">lot</field>
        </record>
        
        <record id="product_hydraulic_oil" model="product.template">
            <field name="name">Aceite Hidráulico ISO 46</field>
            <field name="type">consu</field>
            <field name="is_storable">True</field>
            <field name="categ_id" ref="product_category_oils"/>
            <field name="list_price">38.00</field>
            <field name="standard_price">25.00</field>
            <field name="uom_id" ref="uom.product_uom_litre"/>
            <field name="uom_po_id" ref="uom.product_uom_litre"/>
            <field name="tracking">lot</field>
        </record>
        
        <record id="product_grease" model="product.template">
            <field name="name">Grasa Multiuso</field>
            <field name="type">consu</field>
            <field name="is_storable">True</field>
            <field name="categ_id" ref="product_category_oils"/>
            <field name="list_price">12.00</field>
            <field name="standard_price">8.00</field>
            <field name="uom_id" ref="uom.product_uom_kgm"/>
        <field name="uom_po_id" ref="uom.product_uom_kgm"/>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">True</field>
            <field name="tracking">lot</field>
        </record>
        
        <!-- Componentes Eléctricos -->
        <record id="product_spark_plug" model="product.template">
            <field name="name">Bujía de Encendido</field>
            <field name="type">consu</field>
            <field name="is_storable">True</field>
            <field name="categ_id" ref="product_category_electrical_parts"/>
            <field name="list_price">8.00</field>
            <field name="standard_price">5.00</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="uom_po_id" ref="uom.product_uom_unit"/>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">True</field>
            <field name="tracking">serial</field>
        </record>
        
        <record id="product_battery" model="product.template">
            <field name="name">Batería 12V</field>
            <field name="type">consu</field>
            <field name="is_storable">True</field>
