            <field name="code">FONT</field>
            <field name="sequence">50</field>
            <field name="description">Sistemas de fontanería y tuberías</field>
            <field name="active">True</field>
        </record>

        <record id="service_area_general" model="patco.service.area">
            <field name="name">General</field>
            <field name="code">GEN</field>
            <field name="sequence">60</field>
            <field name="description">Servicios generales y multidisciplinarios</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>