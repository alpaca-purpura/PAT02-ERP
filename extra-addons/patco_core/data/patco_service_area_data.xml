        <!-- Service Area Initial Data -->
        <record id="service_area_cocina_calor" model="patco.service.area">
            <field name="name">Cocina - Calor</field>
            <field name="code">COC-CAL</field>
            <field name="sequence">10</field>
            <field name="description">Equipos de cocina de calor (hornos, freidoras, planchas)</field>
            <field name="active">True</field>
        </record>

        <record id="service_area_cocina_preparacion" model="patco.service.area">
