<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Regla: Técnicos solo ven sus propias órdenes de servicio -->
        <record id="fsm_order_technician_rule" model="ir.rule">
            <field name="name">FSM Order: Técnicos ven solo sus órdenes</field>
            <field name="model_id" ref="fieldservice.model_fsm_order"/>
            <field name="domain_force">[('person_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_patco_technician'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- Regla: Líderes técnicos ven órdenes de su equipo -->
        <record id="fsm_order_leader_rule" model="ir.rule">
            <field name="name">FSM Order: Líderes ven órdenes de su equipo</field>
            <field name="model_id" ref="fieldservice.model_fsm_order"/>
            <field name="domain_force">['|', ('person_ids', 'in', [user.id]), ('person_ids.parent_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_patco_tech_leader'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        
        <!-- Regla: Administradores ven todas las órdenes -->
        <record id="fsm_order_admin_rule" model="ir.rule">
            <field name="name">FSM Order: Administradores ven todas las órdenes</field>
            <field name="model_id" ref="fieldservice.model_fsm_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_patco_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        
