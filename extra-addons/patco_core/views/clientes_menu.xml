<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Acción de ventana para mostrar solo clientes -->
        <record id="action_partner_customer_form" model="ir.actions.act_window">
            <field name="name">Clientes</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('is_company', '=', True), ('customer_rank', '>', 0)]</field>
            <field name="context">{'default_is_company': True, 'default_customer_rank': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crear un nuevo cliente
                </p>
            </field>
        </record>

        <!-- Submenú Clientes bajo el menú principal de Contactos -->
        <menuitem id="menu_clientes"
                  name="Clientes"
                  parent="contacts.menu_contacts"
                  action="action_partner_customer_form"
                  sequence="1"/>
    </data>
</odoo>