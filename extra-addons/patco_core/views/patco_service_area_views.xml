<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_patco_service_area_tree" model="ir.ui.view">
            <field name="name">patco.service.area.tree</field>
            <field name="model">patco.service.area</field>
            <field name="arch" type="xml">
                <list string="Service Area">
                    <field name="sequence" widget="handle"/>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_patco_service_area_form" model="ir.ui.view">
            <field name="name">patco.service.area.form</field>
            <field name="model">patco.service.area</field>
            <field name="arch" type="xml">
                <form string="Service Area">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                                <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="name" placeholder="ej: Cocina - Lavandería"/>
                                <field name="code" placeholder="ej: COC-LAV"/>
                            </group>
                            <group>
                                <field name="sequence"/>
                            </group>
                        </group>
                        <group>
                            <field name="description" placeholder="Descripción detallada del área de especialización..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_patco_service_area_search" model="ir.ui.view">
            <field name="name">patco.service.area.search</field>
            <field name="model">patco.service.area</field>
            <field name="arch" type="xml">
                <search string="Service Area">
                    <field name="name" string="Area" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                    <field name="code"/>
                    <separator/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Active" name="group_active" context="{'group_by': 'active'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_patco_service_area" model="ir.actions.act_window">
            <field name="name">Service Area</field>
            <field name="res_model">patco.service.area</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crear una nueva área de especialización
                </p>
                <p>
                    Las áreas de especialización definen el campo técnico específico,
                    como Cocina-Lavandería, Refrigeración, Aire Acondicionado, etc.
                </p>
            </field>
        </record>

    </data>
</odoo>