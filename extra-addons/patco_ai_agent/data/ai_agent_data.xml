<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Partner del Agente IA -->
    <record id="ai_agent_partner" model="res.partner">
        <field name="name">🤖 Asistente IA PATCO</field>
        <field name="is_company" eval="False"/>
        <field name="email">ai-agent@patco.com.pe</field>
        <field name="phone">+51-1-234-5678</field>
        <field name="website">https://patco.com.pe</field>
        <field name="comment">
            Partner virtual que representa al Asistente IA PATCO en las conversaciones.
            Este partner se utiliza como autor de los mensajes generados por el sistema de IA.
        </field>
        <field name="category_id" eval="[(6, 0, [])]"/>
    </record>
    
    <!-- Usuario del Agente IA para aparecer en conversaciones -->
    <record id="ai_agent_user" model="res.users">
        <field name="login">ai_bot_patco</field>
        <field name="partner_id" ref="ai_agent_partner"/>
        <field name="active" eval="True"/>
        <field name="share" eval="False"/>
        <field name="groups_id" eval="[(6, 0, [ref('base.group_user'), ref('mail.group_mail_template_editor')])]"/>
    </record>
    
    <!-- Configuración de parámetros del sistema para IA -->
    <record id="ir_config_parameter_ai_enabled" model="ir.config_parameter">
        <field name="key">patco_ai_agent.ai_enabled</field>
        <field name="value">True</field>
    </record>
    
    <record id="ir_config_parameter_ai_auto_start" model="ir.config_parameter">
        <field name="key">patco_ai_agent.ai_auto_start_enabled</field>
        <field name="value">True</field>
    </record>
    
    <!-- Configuración de API Key de Gemini (debe configurarse manualmente por seguridad) -->
    <record id="ir_config_parameter_gemini_api_key" model="ir.config_parameter">
        <field name="key">patco_ai_agent.gemini_api_key</field>
        <field name="value">AIzaSyDgs5BnGU0bT0RLX7GC_4VR_bDprrFEzYU</field>
    </record>
    
    <!-- Configuración del modelo de embedding -->
    <record id="ir_config_parameter_embedding_model" model="ir.config_parameter">
        <field name="key">patco_ai_agent.embedding_model</field>
        <field name="value">text-embedding-004</field>
    </record>
    
    <record id="ir_config_parameter_ai_indexing_batch_size" model="ir.config_parameter">
        <field name="key">patco_ai_agent.indexing_batch_size</field>
        <field name="value">50</field>
    </record>
    
    <record id="ir_config_parameter_ai_similarity_threshold" model="ir.config_parameter">
        <field name="key">patco_ai_agent.similarity_threshold</field>
        <field name="value">0.7</field>
    </record>
    
    <record id="ir_config_parameter_ai_max_results" model="ir.config_parameter">
        <field name="key">patco_ai_agent.max_search_results</field>
        <field name="value">10</field>
    </record>
    
    <!-- Datos de ejemplo para tipos de documentos (comentados temporalmente para Fase 1) -->
