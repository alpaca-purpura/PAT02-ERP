    <!-- Plantilla de mensaje inicial para conversaciones IA -->
    <record id="ai_initial_message_template" model="mail.template">
        <field name="name">Mensaje Inicial IA - Orden FSM</field>
        <field name="model_id" ref="model_ai_conversation"/>
        <field name="subject">Asistente IA - ${object.fsm_order_id.name}</field>
        <field name="body_html"><![CDATA[
            <div style="font-family: Arial, sans-serif; max-width: 600px;">
                <h2 style="color: #2E86AB;">¡Hola ${object.technician_id.name}! 👋</h2>
                
                <p>Soy tu <strong>Asistente IA PATCO</strong> para la orden de servicio <strong>${object.fsm_order_id.name}</strong>.</p>
                
                <div style="background-color: #f8f9fa; padding: 15px; border-radius: 5px; margin: 15px 0;">
                    <h3 style="color: #495057; margin-top: 0;">📋 Detalles del servicio:</h3>
                    <ul style="margin: 10px 0;">
                        <li><strong>Cliente:</strong> ${object.fsm_order_id.partner_id.name}</li>
                        <li><strong>Ubicación:</strong> ${object.fsm_order_id.location_id.name or 'No especificada'}</li>
                        <li><strong>Equipos asignados:</strong> ${len(object.fsm_order_id.equipment_ids)} equipos</li>
                        % if object.fsm_order_id.x_service_nature_id:
                        <li><strong>Naturaleza:</strong> ${object.fsm_order_id.x_service_nature_id.name}</li>
                        % endif
                    </ul>
                </div>
                
                <p>Te ayudaré durante todo el proceso proporcionando:</p>
                <ul>
                    <li>🔍 Acceso a manuales técnicos y procedimientos</li>
                    <li>📝 Guía paso a paso para el servicio</li>
                    <li>📊 Generación automática de reportes</li>
                    <li>💡 Recomendaciones basadas en el historial</li>
                </ul>
                
                <div style="background-color: #d4edda; padding: 15px; border-radius: 5px; margin: 15px 0; border-left: 4px solid #28a745;">
                    <p style="margin: 0;"><strong>¿Has llegado al sitio y estás listo para comenzar?</strong></p>
                    <p style="margin: 5px 0 0 0; font-size: 14px; color: #6c757d;">
                        Puedes preguntarme sobre cualquier equipo, procedimiento o problema técnico.
                    </p>
                </div>
            </div>
        ]]></field>
        <field name="lang">${object.technician_id.user_id.lang}</field>
        <field name="auto_delete" eval="False"/>
    </record>
    
    <!-- Secuencia para conversaciones IA -->
    <record id="sequence_ai_conversation" model="ir.sequence">
        <field name="name">Conversación IA</field>
        <field name="code">ai.conversation</field>
        <field name="prefix">IA-</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>
    
    <!-- Cron job para indexación automática (deshabilitado por defecto) -->
    <record id="cron_auto_indexing" model="ir.cron">
        <field name="name">Indexación Automática RAG</field>
        <field name="model_id" ref="base.model_ir_attachment"/>
        <field name="state">code</field>
        <field name="code">
# Obtener documentos candidatos para indexación
candidates = model.get_indexing_candidates(limit=10)
if candidates:
    # Por ahora solo marcar como procesados
    # En fases posteriores se integrará con el servicio de indexación
    for doc in candidates:
        doc.mark_indexing_complete()
        </field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="False"/>
    </record>

</odoo>