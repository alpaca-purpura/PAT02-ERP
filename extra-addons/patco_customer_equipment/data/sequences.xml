<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Secuencia para códigos de equipos PATCO -->
        <record id="seq_patco_equipment_code" model="ir.sequence">
            <field name="name">Códigos de Equipos PATCO</field>
            <field name="code">maintenance.equipment.patco</field>
            <field name="prefix">EQ</field>
