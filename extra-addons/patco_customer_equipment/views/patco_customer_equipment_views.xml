<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista Tree para Equipos de Cliente -->
        <record id="view_patco_customer_equipment_tree" model="ir.ui.view">
            <field name="name">maintenance.equipment.tree.patco</field>
            <field name="model">maintenance.equipment</field>
            <field name="arch" type="xml">
                <list string="Equipos de Cliente">
                    <field name="name"/>
                    <field name="x_patco_code"/>
                    <field name="x_customer_id"/>
                    <field name="category_id"/>
                    <field name="model"/>
                    <field name="serial_no"/>
                    <field name="x_service_location_id"/>
                    <field name="x_service_count"/>
                    <field name="x_last_service_date"/>
                    <field name="maintenance_state"/>
                </list>
            </field>
        </record>

        <!-- Vista Form para Equipos de Cliente -->
        <record id="view_patco_customer_equipment_form" model="ir.ui.view">
            <field name="name">maintenance.equipment.form.patco</field>
            <field name="model">maintenance.equipment</field>
            <field name="arch" type="xml">
                <form string="Equipo de Cliente">
                    <header>
                         <button name="action_activate" type="object" string="Activar" 
                                 class="oe_highlight" invisible="maintenance_state != 'draft'"/>
                         <button name="action_maintenance" type="object" string="En Mantenimiento" 
                                 invisible="maintenance_state != 'active'"/>
                         <button name="action_retire" type="object" string="Retirar" 
                                 invisible="maintenance_state in ['draft', 'retired']"/>
                         <field name="maintenance_state" widget="statusbar" statusbar_visible="draft,active,maintenance,retired"/>
                     </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_service_orders" type="object" 
                                    class="oe_stat_button" icon="fa-wrench"
                                    invisible="x_service_count == 0">
                                <field name="x_service_count" widget="statinfo" string="Servicios"/>
                            </button>
                            <button name="action_view_helpdesk_tickets" type="object" 
                                    class="oe_stat_button" icon="fa-life-ring"
                                    invisible="x_ticket_count == 0">
                                <field name="x_ticket_count" widget="statinfo" string="Tickets"/>
                            </button>
                        </div>
                        
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Nombre del equipo..."/>
                            </h1>
                            <h2>
                                <field name="x_patco_code" readonly="1"/>
                            </h2>
                        </div>
                        
                        <group>
                            <group name="basic_info" string="Información Básica">
                                <field name="x_customer_id" string="Cliente" required="1"/>
                                <field name="x_service_location_id" string="Ubicación del Servicio"/>
                                <field name="category_id" string="Categoría"/>
                                <field name="model"/>
                                <field name="serial_no"/>
                            </group>
                            <group name="qr_info" string="Código QR">
                                <field name="x_qr_code" widget="image" class="oe_avatar"/>
                                <field name="x_qr_url" widget="url"/>
                                <button name="regenerate_qr_code" type="object" string="Regenerar QR" class="btn-secondary"/>
                            </group>
                        </group>
                        
                        <group name="service_info" string="Información de Servicio">
                            <group>
                                <field name="x_last_service_date" readonly="1"/>
                                <field name="x_service_count" readonly="1"/>
                            </group>
                            <group>
                                <field name="x_ticket_count" readonly="1"/>
                                <field name="active"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Descripción">
                                <field name="description" placeholder="Descripción detallada del equipo..."/>
                            </page>
                            <page string="Órdenes de Servicio">
                                <field name="x_service_order_ids" readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="location_id"/>
                                        <field name="scheduled_date_start"/>
                                        <field name="stage_id"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Tickets de Soporte">
                                <field name="x_helpdesk_ticket_ids" readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="partner_id"/>
                                        <field name="create_date"/>
                                        <field name="stage_id"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Vista Search para Equipos de Cliente -->
        <record id="view_patco_customer_equipment_search" model="ir.ui.view">
            <field name="name">maintenance.equipment.search.patco</field>
            <field name="model">maintenance.equipment</field>
            <field name="arch" type="xml">
                <search string="Buscar Equipos">
                    <field name="name" string="Nombre"/>
                    <field name="x_patco_code" string="Código"/>
                    <field name="x_customer_id" string="Cliente"/>
                    <field name="category_id" string="Categoría"/>
                    <field name="model" string="Modelo"/>
                    <field name="serial_no" string="Número de Serie"/>
                    <field name="x_service_location_id" string="Ubicación"/>
                    
                    <filter name="active" string="Activos" domain="[('maintenance_state', '=', 'active')]"/>
                    <filter name="maintenance" string="En Mantenimiento" domain="[('maintenance_state', '=', 'maintenance')]"/>
                    <filter name="draft" string="Borrador" domain="[('maintenance_state', '=', 'draft')]"/>
                    <filter name="retired" string="Retirados" domain="[('maintenance_state', '=', 'retired')]"/>
                    
                    <separator/>
                    <filter name="with_services" string="Con Servicios" domain="[('x_service_count', '>', 0)]"/>
                    <filter name="with_tickets" string="Con Tickets" domain="[('x_ticket_count', '>', 0)]"/>
                    
                    <group expand="0" string="Agrupar Por">
                        <filter name="group_partner" string="Cliente" context="{'group_by': 'x_customer_id'}"/>
                        <filter name="group_brand" string="Categoría" context="{'group_by': 'category_id'}"/>
                        <filter name="group_state" string="Estado" context="{'group_by': 'maintenance_state'}"/>
                        <filter name="group_location" string="Ubicación" context="{'group_by': 'x_service_location_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Acción de Ventana para Equipos de Cliente -->
        <record id="action_patco_customer_equipment" model="ir.actions.act_window">
            <field name="name">Equipos de Cliente</field>
            <field name="res_model">maintenance.equipment</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_patco_customer_equipment_search"/>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    ¡Crea tu primer equipo de cliente!
                </p>
                <p>
                    Los equipos de cliente te permiten gestionar y dar seguimiento
                    a los activos de tus clientes, incluyendo información de servicio
                    y códigos QR para identificación rápida.
                </p>
            </field>
        </record>

    </data>
</odoo>