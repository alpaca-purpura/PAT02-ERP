<?xml version="1.0" encoding="utf-8"?>
<odoo>    
    <!-- Acción para Hojas de Trabajo -->
    <record id="action_fsm_worksheet_patco" model="ir.actions.act_window">
        <field name="name">Hojas de Trabajo</field>
        <field name="res_model">fsm.worksheet</field>
        <field name="view_mode">list,form</field>
        <field name="context">{
            'search_default_my_worksheets': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay hojas de trabajo creadas
            </p>
            <p>
                Las hojas de trabajo se crean automáticamente desde las órdenes de servicio
                y permiten documentar el trabajo realizado.
            </p>
        </field>
    </record>

    <!-- Acción para Plantillas de Hojas de Trabajo -->
    <record id="action_fsm_worksheet_template" model="ir.actions.act_window">
        <field name="name">Plantillas de Hojas de Trabajo</field>
        <field name="res_model">fsm.worksheet.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Crea tu primera plantilla!
            </p>
            <p>
                Las plantillas definen la estructura de las hojas de trabajo
                que se crearán automáticamente para cada tipo de servicio.
            </p>
        </field>
    </record>
</odoo>