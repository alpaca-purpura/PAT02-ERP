<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Vistas para Tipos de Habilidades -->
        <record id="view_hr_skill_type_list" model="ir.ui.view">
        <field name="name">hr.skill.type.list</field>
            <field name="model">hr.skill.type</field>
            <field name="arch" type="xml">
                <list string="Tipos de Habilidades">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="skill_count"/>
                    <field name="description"/>
                </list>
            </field>
        </record>
        
        <record id="view_hr_skill_type_form" model="ir.ui.view">
            <field name="name">hr.skill.type.form</field>
            <field name="model">hr.skill.type</field>
            <field name="arch" type="xml">
                <form string="Tipo de Habilidad">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Nombre del tipo de habilidad"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="skill_count"/>
                            </group>
                            <group>
                                <field name="active"/>
                            </group>
                        </group>
                        <group string="Descripción">
                            <field name="description" nolabel="1" placeholder="Descripción del tipo de habilidad..."/>
                        </group>
                        <notebook>
                            <page string="Habilidades" name="skills">
                                <field name="skill_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="employee_count"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Vistas para Niveles de Habilidades -->
        <record id="view_hr_skill_level_list" model="ir.ui.view">
        <field name="name">hr.skill.level.list</field>
            <field name="model">hr.skill.level</field>
            <field name="arch" type="xml">
                <list string="Niveles de Habilidades">
                    <field name="name"/>
                    <field name="level_progress"/>
                    <field name="description"/>
                </list>
            </field>
        </record>
        
        <record id="view_hr_skill_level_form" model="ir.ui.view">
            <field name="name">hr.skill.level.form</field>
            <field name="model">hr.skill.level</field>
            <field name="arch" type="xml">
                <form string="Nivel de Habilidad">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Nombre del nivel"/>
                            </h1>
                        </div>
                        <group>
                            <field name="level_progress"/>
                        </group>
                        <group string="Descripción">
                            <field name="description" nolabel="1" placeholder="Descripción del nivel..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Vistas para Habilidades -->
        <record id="view_hr_skill_list" model="ir.ui.view">
        <field name="name">hr.skill.list</field>
            <field name="model">hr.skill</field>
            <field name="arch" type="xml">
                <list string="Habilidades">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="skill_type_id"/>
                    <field name="employee_count"/>
                    <field name="active"/>
                </list>
            </field>
        </record>
        
        <record id="view_hr_skill_form" model="ir.ui.view">
            <field name="name">hr.skill.form</field>
            <field name="model">hr.skill</field>
            <field name="arch" type="xml">
                <form string="Habilidad">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Nombre de la habilidad"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="skill_type_id"/>
                            </group>
                            <group>
                                <field name="employee_count"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <group string="Descripción">
                            <field name="description" nolabel="1" placeholder="Descripción de la habilidad..."/>
                        </group>
                        <notebook>
                            <page string="Empleados" name="employees">
                                <field name="employee_skill_ids">
                                    <list>
                                        <field name="employee_id"/>
                                        <field name="skill_level_id"/>
                                        <field name="level_progress"/>
                                        <field name="is_certified"/>
                                        <field name="certification_date"/>
                                        <field name="date_start"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        
        <record id="view_hr_skill_search" model="ir.ui.view">
            <field name="name">hr.skill.search</field>
            <field name="model">hr.skill</field>
            <field name="arch" type="xml">
                <search string="Buscar Habilidades">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="skill_type_id"/>
                    <filter string="Activas" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Inactivas" name="inactive" domain="[('active', '=', False)]"/>
                    <group expand="0" string="Agrupar por">
                        <filter string="Tipo de Habilidad" name="group_by_skill_type" context="{'group_by': 'skill_type_id'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Vistas para Habilidades de Empleados -->
        <record id="view_hr_employee_skill_list" model="ir.ui.view">
        <field name="name">hr.employee.skill.list</field>
            <field name="model">hr.employee.skill</field>
            <field name="arch" type="xml">
                <list string="Habilidades de Empleados" editable="bottom">
                    <field name="employee_id"/>
                    <field name="skill_id"/>
                    <field name="skill_type_id"/>
                    <field name="skill_level_id"/>
                    <field name="level_progress"/>
                    <field name="is_certified"/>
                    <field name="certification_date" invisible="is_certified == False"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                </list>
            </field>
        </record>
        
        <record id="view_hr_employee_skill_form" model="ir.ui.view">
            <field name="name">hr.employee.skill.form</field>
            <field name="model">hr.employee.skill</field>
            <field name="arch" type="xml">
                <form string="Habilidad del Empleado">
                    <sheet>
                        <group>
                            <group>
                                <field name="employee_id"/>
                                <field name="skill_id"/>
                                <field name="skill_type_id"/>
                            </group>
                            <group>
                                <field name="skill_level_id"/>
                                <field name="level_progress"/>
                                <field name="is_certified"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="date_start"/>
                                <field name="date_end"/>
                            </group>
                            <group>
                                <field name="certification_date" invisible="is_certified == False"/>
                                <field name="certification_body" invisible="is_certified == False"/>
                            </group>
                        </group>
                        <group string="Notas">
                            <field name="notes" nolabel="1" placeholder="Notas adicionales sobre la habilidad..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        
        <record id="view_hr_employee_skill_search" model="ir.ui.view">
            <field name="name">hr.employee.skill.search</field>
            <field name="model">hr.employee.skill</field>
            <field name="arch" type="xml">
                <search string="Buscar Habilidades de Empleados">
                    <field name="employee_id"/>
                    <field name="skill_id"/>
                    <field name="skill_type_id"/>
                    <field name="skill_level_id"/>
                    <filter string="Certificadas" name="certified" domain="[('is_certified', '=', True)]"/>
                    <filter string="No Certificadas" name="not_certified" domain="[('is_certified', '=', False)]"/>
                    <filter string="Activas" name="active" domain="[('date_end', '=', False)]"/>
                    <filter string="Vencidas" name="expired" domain="[('date_end', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                    <group expand="0" string="Agrupar por">
                        <filter string="Empleado" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                        <filter string="Habilidad" name="group_by_skill" context="{'group_by': 'skill_id'}"/>
                        <filter string="Tipo de Habilidad" name="group_by_skill_type" context="{'group_by': 'skill_type_id'}"/>
                        <filter string="Nivel" name="group_by_level" context="{'group_by': 'skill_level_id'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Vistas para Historial de Habilidades -->
        <record id="view_hr_employee_skill_log_list" model="ir.ui.view">
        <field name="name">hr.employee.skill.log.list</field>
            <field name="model">hr.employee.skill.log</field>
            <field name="arch" type="xml">
                <list string="Historial de Habilidades" create="false" edit="false">
                    <field name="date"/>
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <field name="skill_id"/>
                    <field name="skill_type_id"/>
                    <field name="old_level_progress"/>
                    <field name="new_level_progress"/>
                    <field name="change_type"/>
                </list>
            </field>
        </record>
        
        <record id="view_hr_employee_skill_log_form" model="ir.ui.view">
            <field name="name">hr.employee.skill.log.form</field>
            <field name="model">hr.employee.skill.log</field>
            <field name="arch" type="xml">
                <form string="Registro de Habilidad" create="false" edit="false">
                    <sheet>
                        <group>
                            <group>
                                <field name="date"/>
                                <field name="employee_id"/>
                                <field name="department_id"/>
                            </group>
                            <group>
                                <field name="skill_id"/>
                                <field name="skill_type_id"/>
                                <field name="change_type"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="old_level_progress"/>
                                <field name="new_level_progress"/>
                            </group>
                        </group>
                        <group string="Notas">
                            <field name="notes" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Acciones de Ventana -->
        <record id="action_hr_skill_type" model="ir.actions.act_window">
            <field name="name">Tipos de Habilidades</field>
            <field name="res_model">hr.skill.type</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    ¡Crea tu primer tipo de habilidad!
                </p>
                <p>
                    Los tipos de habilidades te permiten categorizar las diferentes competencias de tus empleados.
                </p>
            </field>
        </record>
        
        <record id="action_hr_skill_level" model="ir.actions.act_window">
            <field name="name">Niveles de Habilidades</field>
            <field name="res_model">hr.skill.level</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    ¡Define los niveles de competencia!
                </p>
                <p>
                    Los niveles te permiten medir el grado de competencia de tus empleados en cada habilidad.
                </p>
            </field>
        </record>
        
        <record id="action_hr_skill" model="ir.actions.act_window">
            <field name="name">Habilidades</field>
            <field name="res_model">hr.skill</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    ¡Crea tu primera habilidad!
                </p>
                <p>
                    Las habilidades representan las competencias específicas que pueden tener tus empleados.
                </p>
            </field>
        </record>
        
        <record id="action_hr_employee_skill" model="ir.actions.act_window">
            <field name="name">Habilidades de Empleados</field>
            <field name="res_model">hr.employee.skill</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    ¡Asigna habilidades a tus empleados!
                </p>
                <p>
                    Aquí puedes gestionar las habilidades de cada empleado y su nivel de competencia.
                </p>
            </field>
        </record>
        
        <record id="action_hr_employee_skill_log" model="ir.actions.act_window">
            <field name="name">Historial de Habilidades</field>
            <field name="res_model">hr.employee.skill.log</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Historial de cambios en habilidades
                </p>
                <p>
                    Aquí puedes ver el historial de todos los cambios realizados en las habilidades de los empleados.
                </p>
            </field>
        </record>
        
    </data>
</odoo>