        <!-- Categorías de equipos de mantenimiento -->
        <record id="equipment_category_kitchen" model="maintenance.equipment.category">
            <field name="name">Equipos de Cocina</field>
            <field name="color">1</field>
        </record>
        
        <record id="equipment_category_refrigeration" model="maintenance.equipment.category">
            <field name="name">Equipos de Refrigeración</field>
            <field name="color">2</field>
        </record>
        
        <record id="equipment_category_hvac" model="maintenance.equipment.category">
            <field name="name">Climatización (HVAC)</field>
            <field name="color">3</field>
        </record>
        
        <record id="equipment_category_laundry" model="maintenance.equipment.category">
            <field name="name">Equipos de Lavandería</field>
            <field name="color">4</field>
        </record>
        
        <record id="equipment_category_bar" model="maintenance.equipment.category">
            <field name="name">Equipos de Bar</field>
            <field name="color">5</field>
        </record>
        
        <!-- Tipos de mantenimiento -->
        <record id="maintenance_stage_new" model="maintenance.stage">
            <field name="name">Nuevo</field>
            <field name="sequence">1</field>
            <field name="fold">False</field>
        </record>
        
        <record id="maintenance_stage_in_progress" model="maintenance.stage">
            <field name="name">En Progreso</field>
            <field name="sequence">2</field>
            <field name="fold">False</field>
        </record>
        
        <record id="maintenance_stage_done" model="maintenance.stage">
            <field name="name">Completado</field>
            <field name="sequence">3</field>
            <field name="fold">True</field>
        </record>
        
        <record id="maintenance_stage_cancelled" model="maintenance.stage">
            <field name="name">Cancelado</field>
            <field name="sequence">4</field>
            <field name="fold">True</field>
        </record>
        
        <!-- Etapas de proyecto -->
        <record id="project_stage_planning" model="project.project.stage">
            <field name="name">Planificación</field>
            <field name="sequence">1</field>
            <field name="fold">False</field>
        </record>
        
        <record id="project_stage_execution" model="project.project.stage">
            <field name="name">Ejecución</field>
            <field name="sequence">2</field>
            <field name="fold">False</field>
        </record>
        
        <record id="project_stage_completed" model="project.project.stage">
            <field name="name">Completado</field>
            <field name="sequence">3</field>
            <field name="fold">True</field>
        </record>
        
        <!-- Etapas de tareas -->
        <record id="project_task_stage_new" model="project.task.type">
            <field name="name">Nuevo</field>
            <field name="sequence">1</field>
            <field name="fold">False</field>
        </record>
        
        <record id="project_task_stage_in_progress" model="project.task.type">
            <field name="name">En Progreso</field>
            <field name="sequence">2</field>
            <field name="fold">False</field>
        </record>
        
        <record id="project_task_stage_review" model="project.task.type">
            <field name="name">En Revisión</field>
            <field name="sequence">3</field>
            <field name="fold">False</field>
        </record>
        
        <record id="project_task_stage_done" model="project.task.type">
            <field name="name">Completado</field>
            <field name="sequence">4</field>
            <field name="fold">True</field>
        </record>
        
        <!-- Términos de pago -->
        <record id="account_payment_term_15_days" model="account.payment.term">
            <field name="name">15 días</field>
            <field name="note">Pago a 15 días</field>
        </record>
        
        <record id="account_payment_term_15_days_line" model="account.payment.term.line">
            <field name="payment_id" ref="account_payment_term_15_days"/>
            <field name="value">percent</field>
            <field name="value_amount">100.0</field>
            <field name="nb_days">15</field>
        </record>
        
        <record id="account_payment_term_30_days" model="account.payment.term">
            <field name="name">30 días</field>
            <field name="note">Pago a 30 días</field>
        </record>
        
        <record id="account_payment_term_30_days_line" model="account.payment.term.line">
            <field name="payment_id" ref="account_payment_term_30_days"/>
            <field name="value">percent</field>
            <field name="value_amount">100.0</field>
            <field name="nb_days">30</field>
        </record>
        
        <!-- Productos de servicio -->
        <record id="product_maintenance_preventive" model="product.product">
            <field name="name">Mantenimiento Preventivo</field>
            <field name="type">service</field>
            <field name="categ_id" ref="product.product_category_all"/>
            <field name="list_price">150.00</field>
            <field name="standard_price">100.00</field>
            <field name="uom_id" ref="uom.product_uom_hour"/>
            <field name="uom_po_id" ref="uom.product_uom_hour"/>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
        </record>
        
        <record id="product_maintenance_corrective" model="product.product">
            <field name="name">Mantenimiento Correctivo</field>
            <field name="type">service</field>
            <field name="categ_id" ref="product.product_category_all"/>
            <field name="list_price">200.00</field>
            <field name="standard_price">150.00</field>
            <field name="uom_id" ref="uom.product_uom_hour"/>
            <field name="uom_po_id" ref="uom.product_uom_hour"/>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
        </record>
        
        <record id="product_emergency_service" model="product.product">
            <field name="name">Servicio de Emergencia</field>
            <field name="type">service</field>
            <field name="categ_id" ref="product.product_category_all"/>
            <field name="list_price">300.00</field>
            <field name="standard_price">200.00</field>
            <field name="uom_id" ref="uom.product_uom_hour"/>
            <field name="uom_po_id" ref="uom.product_uom_hour"/>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
        </record>
        
    </data>
</odoo>