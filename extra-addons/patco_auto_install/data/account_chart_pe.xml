<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Configuración específica del Plan de Cuentas Peruano para PATCO -->
        
        <!-- Cuentas adicionales específicas para servicios de mantenimiento -->
        <record id="account_income_maintenance_services" model="account.account">
            <field name="code">701001</field>
            <field name="name">Ingresos por Servicios de Mantenimiento</field>
            <field name="account_type">income</field>
            <field name="company_id" ref="base.main_company"/>
        </record>
        
        <record id="account_income_preventive_maintenance" model="account.account">
            <field name="code">701002</field>
            <field name="name">Ingresos por Mantenimiento Preventivo</field>
            <field name="account_type">income</field>
            <field name="company_id" ref="base.main_company"/>
        </record>
        
        <record id="account_income_corrective_maintenance" model="account.account">
            <field name="code">701003</field>
            <field name="name">Ingresos por Mantenimiento Correctivo</field>
            <field name="account_type">income</field>
            <field name="company_id" ref="base.main_company"/>
        </record>
        
        <!-- Cuentas de gastos operativos -->
        <record id="account_expense_materials" model="account.account">
            <field name="code">601001</field>
            <field name="name">Materiales y Repuestos</field>
            <field name="account_type">expense</field>
            <field name="company_id" ref="base.main_company"/>
        </record>
        
        <record id="account_expense_transport" model="account.account">
            <field name="code">631001</field>
            <field name="name">Gastos de Transporte</field>
            <field name="account_type">expense</field>
            <field name="company_id" ref="base.main_company"/>
        </record>
        
        <record id="account_expense_technician_salary" model="account.account">
            <field name="code">621001</field>
            <field name="name">Sueldos y Salarios - Técnicos</field>
            <field name="account_type">expense</field>
            <field name="company_id" ref="base.main_company"/>
        </record>
        
        <!-- Cuentas por cobrar específicas -->
        <record id="account_receivable_maintenance" model="account.account">
            <field name="code">121001</field>
            <field name="name">Cuentas por Cobrar - Servicios de Mantenimiento</field>
            <field name="account_type">asset_receivable</field>
            <field name="reconcile">True</field>
            <field name="company_id" ref="base.main_company"/>
        </record>
        
        <!-- Configuración de propiedades de cuenta para productos -->
        <!-- Comentado temporalmente hasta crear las categorías de productos
        <record id="property_account_income_maintenance" model="ir.property">
            <field name="name">property_account_income_categ_id</field>
            <field name="res_id">product.category,<eval>ref('categ_maintenance_services')</eval></field>
            <field name="value_reference">account.account,<eval>ref('account_income_maintenance_services')</eval></field>
            <field name="company_id" ref="base.main_company"/>
        </record>
        
        <record id="property_account_expense_maintenance" model="ir.property">
            <field name="name">property_account_expense_categ_id</field>
            <field name="res_id">product.category,<eval>ref('categ_maintenance_services')</eval></field>
            <field name="value_reference">account.account,<eval>ref('account_expense_materials')</eval></field>
            <field name="company_id" ref="base.main_company"/>
        </record>
        -->
        
        <!-- Configuración de posiciones fiscales para clientes peruanos -->
        <record id="fiscal_position_peru_local" model="account.fiscal.position">
            <field name="name">Perú - Cliente Local</field>
            <field name="country_id" ref="base.pe"/>
            <field name="auto_apply">True</field>
            <field name="sequence">1</field>
        </record>
        
        <!-- Mapeo de impuestos para la posición fiscal -->
        <!-- El mapeo de impuestos se configura automáticamente con l10n_pe -->
        <!--
        <record id="fiscal_position_tax_mapping_igv" model="account.fiscal.position.tax">
            <field name="position_id" ref="fiscal_position_peru_local"/>
            <field name="tax_src_id" ref="tax_igv_18"/>
            <field name="tax_dest_id" ref="tax_igv_18"/>
        </record>
        -->
        
        <!-- Configuración de métodos de pago -->
        <record id="payment_method_cash" model="account.payment.method">
            <field name="name">Efectivo</field>
            <field name="code">cash</field>
            <field name="payment_type">inbound</field>
        </record>
        
        <record id="payment_method_bank_transfer" model="account.payment.method">
            <field name="name">Transferencia Bancaria</field>
            <field name="code">bank_transfer</field>
            <field name="payment_type">inbound</field>
        </record>
        
        <!-- Configuración de bancos peruanos comunes -->
        <record id="bank_bcp" model="res.bank">
            <field name="name">Banco de Crédito del Perú</field>
            <field name="bic">BCPLPEPL</field>
            <field name="country" ref="base.pe"/>
        </record>
        
        <record id="bank_bbva" model="res.bank">
            <field name="name">BBVA Continental</field>
            <field name="bic">BCONPEPL</field>
            <field name="country" ref="base.pe"/>
        </record>
        
        <record id="bank_interbank" model="res.bank">
            <field name="name">Interbank</field>
            <field name="bic">BINPPEPL</field>
            <field name="country" ref="base.pe"/>
        </record>
        
    </data>
</odoo>