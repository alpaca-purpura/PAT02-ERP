<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Secuencias de numeración para PATCO -->
        
        <!-- Secuencia para Proyectos de Mantenimiento -->
        <record id="seq_project_maintenance" model="ir.sequence">
            <field name="name">Proyectos de Mantenimiento PATCO</field>
            <field name="code">project.maintenance.patco</field>
            <field name="prefix">MANT-</field>
            <field name="suffix">-%(year)s</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" ref="base.main_company"/>
        </record>
        
        <!-- Secuencia para Órdenes de Mantenimiento -->
        <record id="seq_maintenance_request" model="ir.sequence">
            <field name="name">Órdenes de Mantenimiento PATCO</field>
            <field name="code">maintenance.request.patco</field>
            <field name="prefix">OM-</field>
            <field name="suffix">-%(year)s</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" ref="base.main_company"/>
        </record>
        
