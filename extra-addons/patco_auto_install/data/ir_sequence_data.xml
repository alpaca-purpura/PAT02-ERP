        <!-- Secuencia para Contratos de Mantenimiento -->
        <record id="seq_maintenance_contract" model="ir.sequence">
            <field name="name">Contratos de Mantenimiento PATCO</field>
            <field name="code">maintenance.contract.patco</field>
            <field name="prefix">CONT-</field>
            <field name="suffix">-%(year)s</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" ref="base.main_company"/>
        </record>
        
    </data>
</odoo>