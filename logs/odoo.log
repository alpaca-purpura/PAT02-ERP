2025-09-09 16:44:10,318 203 DEBUG odoo_patco odoo.sql_db: [0.526 ms] query: INSERT INTO "ir_act_server" ("binding_model_id", "binding_type", "binding_view_types", "code", "create_date", "create_uid", "evaluation_type", "model_id", "name", "sequence", "state", "type", "update_boolean_value", "update_m2m_operation", "update_path", "usage", "write_date", "write_uid") VALUES (556, 'action', 'list', '
if records:
    # Filtrar solo técnicos de campo
    field_technicians = records.filtered(''is_field_technician'')
    if field_technicians:
        for employee in field_technicians:
            try:
                if not employee.fsm_person_id:
                    employee._create_fsm_person()
                else:
                    employee._sync_to_fsm_person()
            except Exception as e:
                raise UserError(f"Error sincronizando {employee.name}: {str(e)}")
        
        # Mostrar notificación de éxito
        env.user.notify_success(
