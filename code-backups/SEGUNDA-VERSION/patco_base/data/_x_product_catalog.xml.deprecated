<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Producto de Prueba -->
        <record id="service_corrective_hourly" model="product.template">
            <field name="name">Servicio Correctivo por Hora</field>
            <field name="default_code">SRV-CORR-HH</field>
            <field name="type">service</field>
            <field name="categ_id" ref="product_category_maintenance_services"/>
            <field name="list_price">150.00</field>
            <field name="standard_price">100.00</field>
            <field name="uom_id" ref="uom.product_uom_hour"/>
            <field name="uom_po_id" ref="uom.product_uom_hour"/>
            <field name="invoice_policy">delivery</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
        </record>
        
         <record id="product_preventive_maintenance" model="product.product">
            <field name="name">Servicio de Mantenimiento Preventivo</field>
            <field name="type">service</field>
            <field name="categ_id" ref="product_category_maintenance_services"/>
            <field name="list_price">500.00</field>
            <field name="standard_price">300.00</field>
            <field name="uom_id" ref="uom.product_uom_hour"/>
            <field name="uom_po_id" ref="uom.product_uom_hour"/>
            <field name="invoice_policy">delivery</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="description_sale">Servicio de mantenimiento preventivo para equipos industriales</field>
        </record>
        
        <record id="product_corrective_maintenance" model="product.product">
            <field name="name">Servicio de Mantenimiento Correctivo</field>
            <field name="type">service</field>
            <field name="categ_id" ref="product_category_maintenance_services"/>
            <field name="list_price">800.00</field>
            <field name="standard_price">500.00</field>
            <field name="uom_id" ref="uom.product_uom_hour"/>
            <field name="uom_po_id" ref="uom.product_uom_hour"/>
            <field name="invoice_policy">delivery</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="description_sale">Servicio de mantenimiento correctivo para equipos industriales</field>
        </record>
        
        <record id="partner_hotel_example" model="res.partner">
            <field name="name">Hotel Plaza Lima</field>
            <field name="is_company">True</field>
            <field name="customer_rank">1</field>
            <field name="street">Jr. de la Unión 1234</field>
            <field name="city">Lima</field>
            <field name="zip">15001</field>
            <field name="country_id" ref="base.pe"/>
            <field name="phone">+51 1 987-6543</field>
            <field name="email">contacto@hotelplaza.com.pe</field>
        </record>
        
        <record id="partner_restaurant_example" model="res.partner">
            <field name="name">Restaurante El Dorado</field>
            <field name="is_company">True</field>
            <field name="customer_rank">1</field>
            <field name="street">Av. Larco 567</field>
            <field name="city">Miraflores</field>
            <field name="zip">15074</field>
            <field name="country_id" ref="base.pe"/>
            <field name="phone">+51 1 456-7890</field>
            <field name="email">gerencia@eldorado.com.pe</field>
        </record>
        <!-- Las categorías de productos ahora están en product_categories_consolidated.xml -->
        
        <!-- Productos de Servicio -->
        <record id="service_corrective_hourly" model="product.template">
            <field name="name">Servicio Correctivo por Hora</field>
            <field name="type">service</field>
            <field name="list_price">150.00</field>
        </record>
        
        <record id="service_preventive_plan" model="product.template">
            <field name="name">Plan de Mantenimiento Preventivo</field>
            <field name="default_code">PREV-PLAN</field>
            <field name="type">service</field>
            <field name="categ_id" ref="patco_base.product_category_maintenance_services"/>
            <field name="list_price">2400.00</field>
            <field name="standard_price">1800.00</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="uom_po_id" ref="uom.product_uom_unit"/>
            <field name="invoice_policy">order</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
        </record>
        
        <record id="service_equipment_installation" model="product.template">
            <field name="name">Instalación de Equipos</field>
            <field name="default_code">INST-EQUIP</field>
            <field name="type">service</field>
            <field name="categ_id" ref="patco_base.product_category_maintenance_services"/>
            <field name="list_price">500.00</field>
            <field name="standard_price">350.00</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="uom_po_id" ref="uom.product_uom_unit"/>
            <field name="invoice_policy">delivery</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
        </record>
        
        <record id="service_emergency_call" model="product.template">
            <field name="name">Llamada de Emergencia</field>
            <field name="default_code">EMERG-CALL</field>
            <field name="type">service</field>
            <field name="categ_id" ref="patco_base.product_category_maintenance_services"/>
            <field name="list_price">300.00</field>
            <field name="standard_price">200.00</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="uom_po_id" ref="uom.product_uom_unit"/>
            <field name="invoice_policy">delivery</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
        </record>
        
        <!-- Productos Almacenables - Repuestos Comunes -->
        <record id="spare_part_filter_generic" model="product.template">
            <field name="name">Filtro Genérico</field>
            <field name="default_code">FILTER-GEN</field>
            <field name="type">consu</field>
            <field name="categ_id" ref="patco_base.product_category_spare_parts"/>
            <field name="list_price">25.00</field>
            <field name="standard_price">15.00</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="uom_po_id" ref="uom.product_uom_unit"/>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">True</field>
        </record>
        
        <record id="spare_part_gasket_door" model="product.template">
            <field name="name">Empaque de Puerta</field>
            <field name="default_code">GASKET-DOOR</field>
            <field name="type">consu</field>
            <field name="categ_id" ref="patco_base.product_category_spare_parts"/>
            <field name="list_price">45.00</field>
            <field name="standard_price">30.00</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="uom_po_id" ref="uom.product_uom_unit"/>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">True</field>
        </record>
        
        <record id="spare_part_thermostat" model="product.template">
            <field name="name">Termostato</field>
            <field name="default_code">THERMO-01</field>
            <field name="type">consu</field>
            <field name="categ_id" ref="patco_base.product_category_spare_parts"/>
            <field name="list_price">120.00</field>
            <field name="standard_price">80.00</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="uom_po_id" ref="uom.product_uom_unit"/>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">True</field>
        </record>
        <!-- Filtros -->
        <record id="product_air_filter" model="product.template">
            <field name="name">Filtro de Aire</field>
            <field name="type">consumable</field>
            <field name="categ_id" ref="product_category_maintenance_services"/>
            <field name="list_price">25.00</field>
            <field name="standard_price">15.00</field>
        </record>
    </data>
</odoo>