<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Service Area List View -->
        <record id="view_patco_service_area_list" model="ir.ui.view">
            <field name="name">patco.service.area.list</field>
            <field name="model">patco.service.area</field>
            <field name="arch" type="xml">
                <list string="Áreas de Servicio" default_order="sequence,name">
                    <field name="sequence" widget="handle"/>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="active"/>
                </list>
            </field>
        </record>
        
        <!-- Service Area Form View -->
        <record id="view_patco_service_area_form" model="ir.ui.view">
            <field name="name">patco.service.area.form</field>
            <field name="model">patco.service.area</field>
            <field name="arch" type="xml">
                <form string="Área de Servicio">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                                <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="name" placeholder="Nombre del área de servicio"/>
                                <field name="code" placeholder="Código corto"/>
                            </group>
                            <group>
                                <field name="sequence"/>
                            </group>
                        </group>
                        <group>
                            <field name="description" placeholder="Descripción detallada del área de especialización"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Service Area Search View -->
        <record id="view_patco_service_area_search" model="ir.ui.view">
            <field name="name">patco.service.area.search</field>
            <field name="model">patco.service.area</field>
            <field name="arch" type="xml">
                <search string="Buscar Áreas de Servicio">
                    <field name="name" string="Área" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                    <field name="code"/>
                    <field name="description"/>
                    <separator/>
                    <filter string="Activos" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Inactivos" name="inactive" domain="[('active', '=', False)]"/>
                    <group expand="0" string="Agrupar por">
                        <filter string="Estado" name="group_active" context="{'group_by': 'active'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Service Area Action -->
        <record id="action_patco_service_area" model="ir.actions.act_window">
            <field name="name">Áreas de Servicio</field>
            <field name="res_model">patco.service.area</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    ¡Crea tu primera área de servicio!
                </p>
                <p>
                    Las áreas de servicio permiten clasificar los servicios por especialización técnica.
                </p>
            </field>
        </record>
        
        <!-- Menu Item -->
        <menuitem id="menu_patco_service_area"
                  name="Áreas de Servicio"
                  parent="base.menu_administration"
                  action="action_patco_service_area"
                  sequence="10"/>
        
    </data>
</odoo>