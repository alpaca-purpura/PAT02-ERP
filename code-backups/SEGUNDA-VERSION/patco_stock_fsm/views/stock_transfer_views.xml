<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de formulario para solicitudes de transferencia -->
    <record id="view_stock_transfer_request_form" model="ir.ui.view">
        <field name="name">stock.transfer.request.form</field>
        <field name="model">stock.transfer.request</field>
        <field name="arch" type="xml">
            <form string="Solicitud de Transferencia">
                <header>
                    <button name="action_confirm" type="object" string="Confirmar" 
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_create_transfer" type="object" string="Crear Transferencia" 
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" type="object" string="Cancelar" 
                            invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="technician_id" required="1"/>
                            <field name="vehicle_location_id" required="1" 
                                   domain="[('is_vehicle_location', '=', True)]"/>
                        </group>
                        <group>
                            <field name="source_location_id" required="1" 
                                   domain="[('usage', '=', 'internal'), ('is_vehicle_location', '=', False)]"/>
                            <field name="picking_ids" readonly="1" invisible="not picking_ids"/>
                            <field name="notes" placeholder="Notas adicionales..."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Líneas de Transferencia">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id" required="1"/>
                                    <field name="quantity_to_transfer" required="1"/>
                                    <field name="product_uom_id" required="1"/>
                                      <field name="quantity_available" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Información Adicional">
                            <group>
                                <group>
                                    <field name="create_date" readonly="1"/>
                                    <field name="create_uid" readonly="1"/>
                                </group>
                                <group>
                                    <field name="write_date" readonly="1"/>
                                    <field name="write_uid" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Vista de lista para solicitudes de transferencia -->
    <record id="view_stock_transfer_request_list" model="ir.ui.view">
        <field name="name">stock.transfer.request.list</field>
        <field name="model">stock.transfer.request</field>
        <field name="arch" type="xml">
            <list string="Solicitudes de Transferencia" multi_edit="1">
                <field name="name"/>
                <field name="date"/>
                <field name="technician_id"/>
                <field name="vehicle_location_id"/>
                <field name="source_location_id"/>
                <field name="state" decoration-info="state == 'draft'" 
                       decoration-warning="state == 'confirmed'" 
                       decoration-success="state == 'done'" 
                       decoration-muted="state == 'cancelled'" widget="badge"/>
                <field name="picking_ids" optional="hide"/>
                <field name="create_date" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Vista de búsqueda para solicitudes de transferencia -->
    <record id="view_stock_transfer_request_search" model="ir.ui.view">
        <field name="name">stock.transfer.request.search</field>
        <field name="model">stock.transfer.request</field>
        <field name="arch" type="xml">
            <search string="Buscar Solicitudes de Transferencia">
                <field name="name" string="Número"/>
                <field name="technician_id" string="Técnico"/>
                <field name="vehicle_location_id" string="Vehículo"/>
                <field name="source_location_id" string="Ubicación Origen"/>
                <separator/>
                <filter name="draft" string="Borrador" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmado" domain="[('state', '=', 'confirmed')]"/>
                <filter name="done" string="Realizado" domain="[('state', '=', 'done')]"/>
                <filter name="cancelled" string="Cancelado" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="today" string="Hoy" 
                        domain="[('date', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))), ('date', '&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]"/>
                <filter name="this_week" string="Esta Semana" 
                        domain="[('date', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d')), ('date', '&lt;=', (context_today() + datetime.timedelta(days=6-context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <filter name="this_month" string="Este Mes" 
                        domain="[('date', '&gt;=', datetime.datetime.now().strftime('%Y-%m-01')), ('date', '&lt;=', (datetime.datetime.now().replace(day=1) + datetime.timedelta(days=32)).replace(day=1) - datetime.timedelta(days=1))]"/>
                <separator/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_by_technician" string="Técnico" context="{'group_by': 'technician_id'}"/>
                    <filter name="group_by_vehicle" string="Vehículo" context="{'group_by': 'vehicle_location_id'}"/>
                    <filter name="group_by_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_by_date" string="Fecha" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Vista kanban para solicitudes de transferencia -->
    <record id="view_stock_transfer_request_kanban" model="ir.ui.view">
        <field name="name">stock.transfer.request.kanban</field>
        <field name="model">stock.transfer.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="technician_id"/>
                <field name="vehicle_location_id"/>
                <field name="date"/>
                <field name="state"/>
                <field name="picking_ids"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle text-muted">
                                        <field name="date"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_top_right">
                                    <div class="o_dropdown_kanban dropdown">
                                        <a class="dropdown-toggle o-no-caret btn" data-bs-toggle="dropdown" href="#" role="button" aria-label="Dropdown" title="Dropdown">
                                            <span class="fa fa-ellipsis-v"/>
                                        </a>
                                        <div class="dropdown-menu" role="menu">
                                            <a t-if="widget.editable" role="menuitem" type="edit" class="dropdown-item">Editar</a>
                                            <a t-if="widget.deletable" role="menuitem" type="delete" class="dropdown-item">Eliminar</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <div><i class="fa fa-user"/> <field name="technician_id"/></div>
                                        <div><i class="fa fa-truck"/> <field name="vehicle_location_id"/></div>
                                        <t t-if="record.picking_ids.value">
                            <div><i class="fa fa-exchange"/> <field name="picking_ids"/></div>
                                        </t>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <span t-attf-class="badge #{record.state.raw_value == 'draft' and 'text-bg-secondary' or record.state.raw_value == 'confirmed' and 'text-bg-warning' or record.state.raw_value == 'done' and 'text-bg-success' or 'text-bg-danger'}">
                                            <field name="state"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Acción principal para solicitudes de transferencia -->
    <record id="action_stock_transfer_request" model="ir.actions.act_window">
        <field name="name">Solicitudes de Transferencia</field>
        <field name="res_model">stock.transfer.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Crea tu primera solicitud de transferencia!
            </p>
            <p>
                Las solicitudes de transferencia permiten gestionar el movimiento
                de stock desde el almacén central hacia los vehículos de los técnicos.
            </p>
        </field>
    </record>

    <!-- Extensión de la vista de picking para mostrar la solicitud de transferencia -->
    <record id="view_picking_form_transfer_request" model="ir.ui.view">
        <field name="name">stock.picking.form.transfer.request</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="x_transfer_request_id" readonly="1" 
                       invisible="not x_transfer_request_id"/>
            </field>
        </field>
    </record>

    <!-- Vista de formulario para líneas de transferencia -->
    <record id="view_stock_transfer_request_line_form" model="ir.ui.view">
        <field name="name">stock.transfer.request.line.form</field>
        <field name="model">stock.transfer.request.line</field>
        <field name="arch" type="xml">
            <form string="Línea de Transferencia">
                <sheet>
                    <group>
                        <group>
                            <field name="request_id" readonly="1"/>
                            <field name="product_id" required="1"/>
                            <field name="quantity_to_transfer" required="1"/>
                            <field name="product_uom_id" required="1"/>
                         </group>
                         <group>
                             <field name="quantity_available" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>