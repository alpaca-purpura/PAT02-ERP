<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Grupos de Usuarios FSM -->
        <record id="group_fsm_technician" model="res.groups">
            <field name="name">FSM Técnico</field>
            <field name="category_id" ref="base.module_category_field_service"/>
            <field name="comment">Técnicos de campo con acceso a órdenes asignadas</field>
        </record>
        
        <record id="group_fsm_manager" model="res.groups">
            <field name="name">FSM Administrador</field>
            <field name="category_id" ref="base.module_category_field_service"/>
            <field name="implied_ids" eval="[(4, ref('group_fsm_technician'))]"/>
            <field name="comment">Administradores FSM con acceso completo</field>
        </record>
        
        <!-- Reglas de Registro para Órdenes FSM -->
        <record id="fsm_order_technician_rule" model="ir.rule">
            <field name="name">FSM Order: Técnico solo ve sus órdenes</field>
            <field name="model_id" ref="model_fsm_order"/>
            <field name="domain_force">[('person_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_fsm_technician'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <record id="fsm_order_manager_rule" model="ir.rule">
            <field name="name">FSM Order: Administrador ve todas las órdenes</field>
            <field name="model_id" ref="model_fsm_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_fsm_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        
        <!-- Reglas para Hojas de Trabajo -->
        <record id="fsm_worksheet_technician_rule" model="ir.rule">
            <field name="name">FSM Worksheet: Técnico solo ve hojas de sus órdenes</field>
            <field name="model_id" ref="model_fsm_worksheet"/>
            <field name="domain_force">[('order_id.person_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_fsm_technician'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <record id="fsm_worksheet_manager_rule" model="ir.rule">
            <field name="name">FSM Worksheet: Administrador ve todas las hojas</field>
            <field name="model_id" ref="model_fsm_worksheet"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_fsm_manager'))]"/>
        </record>
        
        <!-- Reglas para Repuestos Consumidos -->
        <record id="fsm_consumed_part_technician_rule" model="ir.rule">
            <field name="name">FSM Consumed Part: Técnico solo ve repuestos de sus órdenes</field>
            <field name="model_id" ref="model_fsm_order_consumed_part"/>
            <field name="domain_force">[('order_id.person_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_fsm_technician'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        
        <record id="fsm_consumed_part_manager_rule" model="ir.rule">
            <field name="name">FSM Consumed Part: Administrador ve todos los repuestos</field>
            <field name="model_id" ref="model_fsm_order_consumed_part"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_fsm_manager'))]"/>
        </record>
        
        <!-- Reglas para Plantillas de Hojas de Trabajo -->
        <record id="fsm_worksheet_template_rule" model="ir.rule">
            <field name="name">FSM Worksheet Template: Solo lectura para técnicos</field>
            <field name="model_id" ref="model_fsm_worksheet_template"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_fsm_technician'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <record id="fsm_worksheet_template_manager_rule" model="ir.rule">
            <field name="name">FSM Worksheet Template: Administrador acceso completo</field>
            <field name="model_id" ref="model_fsm_worksheet_template"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_fsm_manager'))]"/>
        </record>
        
    </data>
</odoo>