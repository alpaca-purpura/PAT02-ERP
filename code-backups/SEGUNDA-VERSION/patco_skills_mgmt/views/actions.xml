<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Acción para Técnicos de Campo -->
        <record id="action_hr_field_technicians" model="ir.actions.act_window">
            <field name="name">Técnicos de Campo</field>
            <field name="res_model">hr.employee</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('is_fsm_person', '=', True)]</field>
            <field name="context">{'search_default_is_fsm_person': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    ¡Gestiona tus técnicos de campo!
                </p>
                <p>
                    Aquí puedes ver y gestionar todos los empleados que trabajan como técnicos de campo.
                </p>
            </field>
        </record>
        
        <!-- Acción para Órdenes con Habilidades -->
        <record id="action_fsm_orders_with_skills" model="ir.actions.act_window">
            <field name="name">Órdenes con Habilidades</field>
            <field name="res_model">fsm.order</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('required_skills', '!=', False)]</field>
            <field name="context">{'search_default_required_skills': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    ¡Gestiona órdenes que requieren habilidades específicas!
                </p>
                <p>
                    Aquí puedes ver todas las órdenes de servicio que tienen habilidades requeridas definidas.
                </p>
            </field>
        </record>
        
        <!-- Acción para Órdenes Mal Emparejadas -->
        <record id="action_fsm_orders_poor_match" model="ir.actions.act_window">
            <field name="name">Órdenes Mal Emparejadas</field>
            <field name="res_model">fsm.order</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('required_skills', '!=', False), ('person_id', '!=', False)]</field>
            <field name="context">{'search_default_poor_match': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    ¡Identifica órdenes mal asignadas!
                </p>
                <p>
                    Aquí puedes ver órdenes donde el técnico asignado no tiene las habilidades requeridas.
                </p>
            </field>
        </record>
        
