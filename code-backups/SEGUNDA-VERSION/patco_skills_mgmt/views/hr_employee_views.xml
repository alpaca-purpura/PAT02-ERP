<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Vista de formulario para hr.employee.skill -->
        <record id="view_hr_employee_skill_form" model="ir.ui.view">
            <field name="name">hr.employee.skill.form</field>
            <field name="model">hr.employee.skill</field>
            <field name="arch" type="xml">
                <form string="Habilidad del Empleado">
                    <sheet>
                        <group>
                            <group>
                                <field name="employee_id"/>
                                <field name="skill_id" domain="[('active', '=', True)]"/>
                                <field name="skill_level_id" domain="[('active', '=', True)]"/>
                            </group>
                            <group>
                                <field name="skill_type_id" readonly="1"/>
                                <field name="level_progress" readonly="1"/>
                                <field name="date_start"/>
                                <field name="date_end"/>
                            </group>
                        </group>
                        <group>
                            <field name="notes" placeholder="Notas adicionales sobre esta habilidad..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Vista de lista para hr.employee.skill -->
        <record id="view_hr_employee_skill_list_employee" model="ir.ui.view">
        <field name="name">hr.employee.skill.list.employee</field>
            <field name="model">hr.employee.skill</field>
            <field name="arch" type="xml">
                <list string="Habilidades de Empleados">
                    <field name="employee_id"/>
                    <field name="skill_type_id"/>
                    <field name="skill_id"/>
                    <field name="skill_level_id"/>
                    <field name="level_progress"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                </list>
            </field>
        </record>
        
        <!-- Vista de búsqueda para hr.employee.skill -->
        <record id="view_hr_employee_skill_search_employee" model="ir.ui.view">
            <field name="name">hr.employee.skill.search.employee</field>
            <field name="model">hr.employee.skill</field>
            <field name="arch" type="xml">
                <search string="Buscar Habilidades">
                    <field name="employee_id"/>
                    <field name="skill_id"/>
                    <field name="skill_type_id"/>
                    <field name="skill_level_id"/>
                    <separator/>
                    <filter string="Activas" name="active_skills" domain="[('date_end', '=', False)]"/>
                    <filter string="Vencidas" name="expired_skills" domain="[('date_end', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                    <separator/>
                    <group expand="0" string="Agrupar por">
                        <filter string="Empleado" name="group_employee" context="{'group_by': 'employee_id'}"/>
                        <filter string="Tipo de Habilidad" name="group_skill_type" context="{'group_by': 'skill_type_id'}"/>
                        <filter string="Habilidad" name="group_skill" context="{'group_by': 'skill_id'}"/>
                        <filter string="Nivel" name="group_level" context="{'group_by': 'skill_level_id'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Acción para hr.employee.skill -->
        <record id="action_hr_employee_skill_employee" model="ir.actions.act_window">
            <field name="name">Habilidades de Empleados</field>
            <field name="res_model">hr.employee.skill</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    ¡Crea la primera habilidad de empleado!
                </p>
                <p>
                    Gestiona las habilidades y competencias de tus empleados.
                </p>
            </field>
        </record>
        

        <!-- Vista de formulario extendida para hr.employee -->
        <record id="view_employee_form_skills" model="ir.ui.view">
            <field name="name">hr.employee.form.skills</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="before">
                    <!-- Botones de sincronización FSM -->
                    <header>
                        <button name="action_sync_to_fsm_person" 
                                type="object" 
                                string="Sincronizar con FSM" 
                                class="btn-primary"
                                invisible="not is_field_technician"
                                help="Crear o actualizar la persona FSM asociada"/>
                        
                        <button name="action_sync_skills_to_fsm" 
                                type="object" 
                                string="Sincronizar Habilidades" 
                                class="btn-secondary"
                                invisible="not is_field_technician or not fsm_person_id"
                                help="Sincronizar habilidades del empleado con FSM"/>
                    </header>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page string="Habilidades Técnicas" name="technical_skills">
                        <group>
                            <group>
                                <field name="is_field_technician"/>
                                <field name="main_skills" readonly="1"/>
                            </group>
                        </group>
                        <separator string="Matriz de Competencias Técnicas"/>
                        <field name="employee_skill_ids">
                            <list editable="bottom">
                                <field name="skill_id" domain="[('active', '=', True)]" options="{'no_create': True}"/>
                                <field name="skill_type_id" readonly="1"/>
                                <field name="skill_level_id" domain="[('active', '=', True)]" options="{'no_create': True, 'no_open': True}"/>
                                <field name="level_progress" readonly="1"/>
                                <field name="date_start"/>
                                <field name="date_end"/>
                                <field name="notes"/>
                            </list>
                        </field>
                    </page>
                </xpath>
                <xpath expr="//page[@name='personal_information']" position="inside">
                    <group string="Integración FSM" invisible="not is_field_technician">
                        <field name="fsm_person_id" readonly="1"/>
                        <field name="fsm_sync_date" readonly="1"/>
                        <field name="fsm_sync_status" readonly="1"/>
                    </group>
                </xpath>
            </field>
        </record>

        
        <!-- Vista de lista extendida para hr.employee -->
        <record id="view_hr_employee_list_skills_and_fsm_integration" model="ir.ui.view">
        <field name="name">hr.employee.list.skills</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='job_id']" position="after">
                    <field name="is_field_technician" string="Técnico"/>
                    <field name="main_skills"/>
                    <field name="fsm_sync_status" optional="hide"/>
                    <field name="fsm_person_id" optional="hide"/>
                </xpath>
            </field>
        </record>
        
        <!-- Vista de búsqueda extendida para hr.employee -->
        <record id="view_employee_filter_skills" model="ir.ui.view">
            <field name="name">hr.employee.search.skills</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='inactive']" position="after">
                    <separator/>
                    <filter string="Técnicos de Campo" name="field_technicians" domain="[('is_field_technician', '=', True)]"/>
                </xpath>
                <xpath expr="//group" position="inside">
                </xpath>
            </field>
        </record>
        
        <!-- Acción para ver técnicos de campo -->
        <record id="action_field_technicians" model="ir.actions.act_window">
            <field name="name">Técnicos de Campo</field>
            <field name="res_model">hr.employee</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('is_field_technician', '=', True)]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    ¡Crea el primer técnico de campo!
                </p>
                <p>
                    Los técnicos de campo son empleados especializados en servicios técnicos.
                </p>
            </field>
        </record>
        
        <!-- Menú para técnicos de campo -->
        <menuitem id="menu_field_technicians"
                  name="Técnicos de Campo"
                  parent="hr.menu_hr_root"
                  action="action_field_technicians"
                  sequence="15"/>
                  
        <!-- Menú para gestión de habilidades -->
        <menuitem id="menu_employee_skills"
                  name="Habilidades de Empleados"
                  parent="hr.menu_hr_root"
                  action="action_hr_employee_skill_employee"
                  sequence="16"/>
        
        <!-- Acción de servidor para sincronización masiva -->
        <record id="action_sync_all_field_technicians_server" model="ir.actions.server">
            <field name="name">Sincronizar Todos los Técnicos FSM</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="binding_model_id" ref="hr.model_hr_employee"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
                action = env['hr.employee'].action_sync_all_field_technicians()
            </field>
        </record>
        
        <!-- Acción de servidor para sincronización individual -->
        <record id="action_sync_selected_employees_server" model="ir.actions.server">
            <field name="name">Sincronizar Empleados Seleccionados</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="binding_model_id" ref="hr.model_hr_employee"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
                action = records.action_sync_selected_employees()
            </field>
        </record>
        
        <!-- Acción de servidor para sincronización individual de persona FSM -->
        <record id="action_sync_to_fsm_person_server" model="ir.actions.server">
            <field name="name">Sincronizar con FSM</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="binding_model_id" ref="hr.model_hr_employee"/>
            <field name="binding_view_types">form</field>
            <field name="state">code</field>
            <field name="code">
                action = record.action_sync_to_fsm_person()
            </field>
        </record>
        
        <!-- Acción de servidor para sincronización de habilidades -->
        <record id="action_sync_skills_to_fsm_server" model="ir.actions.server">
            <field name="name">Sincronizar Habilidades a FSM</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="binding_model_id" ref="hr.model_hr_employee"/>
            <field name="binding_view_types">form</field>
            <field name="state">code</field>
            <field name="code">
                action = record.action_sync_skills_to_fsm()
            </field>
        </record>
        
        <!-- Vista de búsqueda extendida -->
        <record id="view_employee_filter_fsm_integration" model="ir.ui.view">
            <field name="name">hr.employee.search.fsm.integration</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='inactive']" position="after">
                    <separator/>
                    <filter name="field_technicians" string="Técnicos de Campo" 
                            domain="[('is_field_technician', '=', True)]"/>
                    <filter name="fsm_synced" string="Sincronizados FSM" 
                            domain="[('fsm_sync_status', '=', 'synced')]"/>
                    <filter name="fsm_pending" string="Pendientes FSM" 
                            domain="[('fsm_sync_status', '=', 'pending')]"/>
                    <filter name="fsm_error" string="Errores FSM" 
                            domain="[('fsm_sync_status', '=', 'error')]"/>
                </xpath>
                
                <xpath expr="//group" position="inside">
                    <filter string="Estado FSM" name="group_fsm_status" 
                            context="{'group_by': 'fsm_sync_status'}"/>
                </xpath>
            </field>
        </record>
        
        <!-- Menú para gestión FSM (opcional) -->
        <record id="action_hr_employee_fsm_management" model="ir.actions.act_window">
            <field name="name">Gestión FSM - Empleados</field>
            <field name="res_model">hr.employee</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('is_field_technician', '=', True)]</field>
            <field name="context">{
                'default_is_field_technician': True,
                'search_default_field_technicians': 1
            }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    ¡Gestiona la integración FSM de tus técnicos de campo!
                </p>
                <p>
                    Desde aquí puedes sincronizar empleados con el sistema FSM,
                    gestionar sus habilidades y monitorear el estado de sincronización.
                </p>
            </field>
        </record>       
    </data>
</odoo>