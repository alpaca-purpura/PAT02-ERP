<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista de formulario del wizard principal -->
        <record id="view_fsm_consume_parts_wizard_form" model="ir.ui.view">
            <field name="name">fsm.consume.parts.wizard.form</field>
            <field name="model">fsm.consume.parts.wizard</field>
            <field name="arch" type="xml">
                <form string="Consumir Repuestos">
                    <sheet>
                        <group>
                            <group>
                                <field name="fsm_order_id" readonly="1"/>
                                <field name="technician_id"/>
                            </group>
                            <group>
                                <field name="vehicle_location_id"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Repuestos a Consumir">
                                <field name="line_ids">
                                    <list editable="bottom">
                                        <field name="product_id"/>
                                        <field name="available_quantity" readonly="1"/>
                                        <field name="quantity_consumed"/>
                                        <field name="uom_id" readonly="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    
                    <footer>
                        <button name="action_consume_parts" string="Consumir Repuestos" 
                                type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Acción del wizard -->
        <record id="action_fsm_consume_parts_wizard" model="ir.actions.act_window">
            <field name="name">Consumir Repuestos</field>
            <field name="res_model">fsm.consume.parts.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'default_fsm_order_id': active_id}</field>
        </record>

    </data>
</odoo>