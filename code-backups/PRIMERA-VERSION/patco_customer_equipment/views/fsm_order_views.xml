<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extensión de la vista form de fsm.order -->
        <record id="view_fsm_order_form_inherit" model="ir.ui.view">
            <field name="name">fsm.order.form.inherit</field>
            <field name="model">fsm.order</field>
            <field name="inherit_id" ref="fieldservice.fsm_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='location_id']" position="after">
                    <field name="x_equipment_id" 
                            domain="[('partner_id', '=', location_id and location_id.partner_id)]"
                           options="{'no_create': True, 'no_edit': True}"
                           readonly="stage_id.is_closed"/>
                </xpath>
            </field>
        </record>

        <!-- Extensión de la vista tree de fsm.order -->
        <record id="view_fsm_order_tree_inherit" model="ir.ui.view">
            <field name="name">fsm.order.tree.inherit</field>
            <field name="model">fsm.order</field>
            <field name="inherit_id" ref="fieldservice.fsm_order_list_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='location_id']" position="after">
                    <field name="x_equipment_id" optional="hide"/>
                </xpath>
            </field>
        </record>

        <!-- Extensión de la vista search de fsm.order -->
        <record id="view_fsm_order_search_inherit" model="ir.ui.view">
            <field name="name">fsm.order.search.inherit</field>
            <field name="model">fsm.order</field>
            <field name="inherit_id" ref="fieldservice.fsm_order_search_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='location_id']" position="after">
                    <field name="x_equipment_id" string="Equipo"/>
                </xpath>
                <xpath expr="//group[@expand='0']" position="inside">
                    <filter name="group_equipment" string="Equipo" context="{'group_by': 'x_equipment_id'}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>